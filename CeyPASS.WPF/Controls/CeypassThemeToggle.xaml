<UserControl x:Class="CeyPASS.WPF.Controls.CeypassThemeToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             VerticalAlignment="Center">
    <Button x:Name="BtnToggle" Click="BtnToggle_OnClick"
            Cursor="Hand" BorderThickness="0" Padding="0"
            Focusable="False" Width="36" Height="28"
            Background="Transparent"
            ToolTip="Açık / koyu tema">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.ChromeHover}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
        <TextBlock x:Name="Glyph" Text="☾" FontSize="15"
                   Foreground="{DynamicResource Brush.ChromeIcon}"/>
    </Button>
</UserControl>
