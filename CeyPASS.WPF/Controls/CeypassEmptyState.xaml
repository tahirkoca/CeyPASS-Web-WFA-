<UserControl x:Class="CeyPASS.WPF.Controls.CeypassEmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Border Background="Transparent" Padding="16">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320">
            <Border Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center" Margin="0,0,0,12"
                    Background="{DynamicResource Brush.PageBg}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                <TextBlock Text="∅" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
            </Border>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="14.5" FontWeight="SemiBold" TextAlignment="Center"
                       Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextMuted}" LineHeight="18"/>
        </StackPanel>
    </Border>
</UserControl>
