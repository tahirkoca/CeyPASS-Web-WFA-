<UserControl x:Class="CeyPASS.WPF.Controls.CeypassHelpTip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             VerticalAlignment="Center">
    <Grid>
        <Button x:Name="BtnHelp" Click="BtnHelp_OnClick"
                Cursor="Hand" BorderThickness="0" Padding="0"
                Focusable="False" Width="32" Height="32"
                Background="Transparent"
                ToolTip="İşlem rehberi">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="16" Width="28" Height="28"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <TextBlock Text="?" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.ChromeHover}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Popup x:Name="HelpPopup"
               PlacementTarget="{Binding ElementName=BtnHelp}"
               Placement="Bottom"
               HorizontalOffset="-280"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Closed="HelpPopup_OnClosed">
            <Border x:Name="PopupRoot" Background="{DynamicResource Brush.Card}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,14"
                    Width="320"
                    MaxHeight="420"
                    Focusable="True"
                    PreviewKeyDown="PopupRoot_OnPreviewKeyDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.18" Color="#0F172A"/>
                </Border.Effect>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="✕" Click="BtnClose_OnClick"
                                Cursor="Hand" BorderThickness="0" Background="Transparent"
                                Padding="6,2" FontSize="12"
                                Foreground="{DynamicResource Brush.TextMuted}"
                                ToolTip="Kapat (Esc)"/>
                        <TextBlock x:Name="TxtTitle" FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="StepsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Text="•" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource Brush.Accent}"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12.5"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   LineHeight="18"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
