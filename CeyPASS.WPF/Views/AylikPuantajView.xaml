<UserControl x:Class="CeyPASS.WPF.Views.AylikPuantajView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:controls="clr-namespace:CeyPASS.WPF.Controls"
             xmlns:wpf="clr-namespace:CeyPASS.WPF"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.PageBg}">
        <Grid Margin="14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Filtreler -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                <DockPanel>
                    <controls:CeypassHelpTip DockPanel.Dock="Right" Topic="AylikPuantaj"
                                             VerticalAlignment="Top" Margin="8,18,0,0"/>
                    <WrapPanel>
                    <StackPanel Width="180" Margin="0,0,12,8">
                        <TextBlock Text="Ay" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Aylar}"
                                  SelectedItem="{Binding SelectedAy}"
                                  DisplayMemberPath="Display"/>
                    </StackPanel>
                    <StackPanel Width="200" Margin="0,0,12,8">
                        <TextBlock Text="Firma" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Firmalar}"
                                  SelectedItem="{Binding SelectedFirma}"
                                  DisplayMemberPath="FirmaAdi"/>
                    </StackPanel>
                    <StackPanel Width="200" Margin="0,0,12,8">
                        <TextBlock Text="İşyeri" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Isyerleri}"
                                  SelectedItem="{Binding SelectedIsyeri}"
                                  DisplayMemberPath="Ad"/>
                    </StackPanel>
                    <StackPanel Width="240" Margin="0,0,12,8">
                        <TextBlock Text="Personel" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Personeller}"
                                  SelectedItem="{Binding SelectedPersonel}"
                                  DisplayMemberPath="AdSoyad"/>
                    </StackPanel>
                    <StackPanel Width="100" Margin="0,0,12,8">
                        <TextBlock Text="Ek kayıt günü" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding EkKayitGunText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEditEkKayit}"
                                 Height="34" Padding="8,6" FontSize="13.5"
                                 wpf:FieldValidation.Error="{Binding Errors[EkKayitGun]}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8" VerticalAlignment="Bottom">
                        <Button Content="Ek Kayıt Ayarla" Style="{StaticResource SecondaryBtn}"
                                Command="{Binding EkKayitAyarlaCommand}"
                                IsEnabled="{Binding CanEditEkKayit}"
                                Padding="14,8"/>
                    </StackPanel>
                </WrapPanel>
                </DockPanel>
            </Border>

            <!-- Toolbar -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10,8" Margin="0,0,0,10">
                <WrapPanel>
                    <Button Content="Onay" Style="{StaticResource SuccessBtn}"
                            Command="{Binding OnayCommand}" Margin="0,0,8,6" Padding="14,8"
                            Visibility="{Binding CanApprove, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Ret" Style="{StaticResource DangerBtn}"
                            Command="{Binding RetCommand}" Margin="0,0,8,6" Padding="14,8"
                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Düzenle" Style="{StaticResource EditBtn}"
                            Command="{Binding DuzenleCommand}" Margin="0,0,8,6" Padding="14,8"
                            Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Bugüne Kadar Onayla" Style="{StaticResource PrimaryBtn}"
                            Command="{Binding BuguneKadarOnaylaCommand}" Margin="0,0,8,6" Padding="14,8"
                            Visibility="{Binding CanApprove, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Çoklu Sicile Aktar" Style="{StaticResource SecondaryBtn}"
                            Command="{Binding CokluSicileAktarCommand}" Margin="0,0,8,6" Padding="14,8"/>
                    <Button Content="Puantaj Yap" Style="{StaticResource PrimaryBtn}"
                            Command="{Binding PuantajYapCommand}" Margin="0,0,8,6" Padding="14,8"
                            Visibility="{Binding CanExport, Converter={StaticResource BoolToVis}}"/>
                </WrapPanel>
            </Border>

            <!-- Grid -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
                <Grid>
                <dxg:GridControl ItemsSource="{Binding Rows}"
                                 SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                 AutoGenerateColumns="None">
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="TarihText" Header="Tarih" Width="160"/>
                        <dxg:GridColumn FieldName="VardiyaTuru" Header="Vardiya Türü" Width="90"/>
                        <dxg:GridColumn FieldName="IlkGirisText" Header="İlk Giriş" Width="70"/>
                        <dxg:GridColumn FieldName="SonCikisText" Header="Son Çıkış" Width="70"/>
                        <dxg:GridColumn FieldName="VardiyaBaslangicText" Header="Vardiya Başlangıç" Width="110"/>
                        <dxg:GridColumn FieldName="VardiyaBitisText" Header="Vardiya Bitiş" Width="100"/>
                        <dxg:GridColumn FieldName="SaatlikIzinDakika" Header="Saatlik İzin" Width="90"/>
                        <dxg:GridColumn FieldName="ErkenGirisDakika" Header="Erken Geliş" Width="90"/>
                        <dxg:GridColumn FieldName="GecCikisDakika" Header="Geç Çıkış" Width="80"/>
                        <dxg:GridColumn FieldName="SistemFMDakika" Header="Sistem FM" Width="80"/>
                        <dxg:GridColumn FieldName="OnayDurumuText" Header="Onay Durumu" Width="100"/>
                        <dxg:GridColumn FieldName="DuzenlenenFMDakika" Header="Düzeltilmiş FM" Width="100"/>
                        <dxg:GridColumn FieldName="Aciklama" Header="Açıklama" Width="*"/>
                        <dxg:GridColumn FieldName="CalismaTipi" Header="Çalışma Tipi" Width="90"/>
                        <dxg:GridColumn FieldName="Saat" Header="Çalışma Saati" Width="90">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings DisplayFormat="0.##"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="IsLocked" Header="" Visible="False"/>
                        <dxg:GridColumn FieldName="OnayDurumu" Header="" Visible="False"/>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView Style="{StaticResource CeypassTableView}">
                            <dxg:TableView.FormatConditions>
                                <dxg:FormatCondition Expression="[IsLocked] = True" ApplyToRow="True">
                                    <dxg:FormatCondition.Format>
                                        <dx:Format Background="#DCDCDC" Foreground="#696969"/>
                                    </dxg:FormatCondition.Format>
                                </dxg:FormatCondition>
                                <dxg:FormatCondition Expression="[IsLocked] = False And [OnayDurumu] = 1" ApplyToRow="True">
                                    <dxg:FormatCondition.Format>
                                        <dx:Format Background="#90EE90"/>
                                    </dxg:FormatCondition.Format>
                                </dxg:FormatCondition>
                                <dxg:FormatCondition Expression="[IsLocked] = False And [OnayDurumu] = 2" ApplyToRow="True">
                                    <dxg:FormatCondition.Format>
                                        <dx:Format Background="#F08080"/>
                                    </dxg:FormatCondition.Format>
                                </dxg:FormatCondition>
                                <dxg:FormatCondition Expression="[IsLocked] = False And [OnayDurumu] = 3" ApplyToRow="True">
                                    <dxg:FormatCondition.Format>
                                        <dx:Format Background="#ADD8E6"/>
                                    </dxg:FormatCondition.Format>
                                </dxg:FormatCondition>
                            </dxg:TableView.FormatConditions>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
                <controls:CeypassEmptyState ItemsSource="{Binding Rows}"
                                            Title="Puantaj satırı yok"
                                            Message="Ay, firma ve personel seçip Puantaj Yap’a basın."/>
                </Grid>
            </Border>

            <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,8,0,0" Foreground="#475569"/>

            <controls:CeypassBusyOverlay Grid.Row="0" Grid.RowSpan="4"
                                         IsBusy="{Binding Busy}"
                                         Title="Puantaj yükleniyor..."
                                         Message="Lütfen bekleyin"/>
        </Grid>
    </Border>
</UserControl>
