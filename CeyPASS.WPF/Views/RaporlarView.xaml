<UserControl x:Class="CeyPASS.WPF.Views.RaporlarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:controls="clr-namespace:CeyPASS.WPF.Controls"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.PageBg}">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                <DockPanel>
                    <controls:CeypassHelpTip DockPanel.Dock="Right" Topic="Raporlar"
                                             VerticalAlignment="Top" Margin="12,22,0,0"/>
                    <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="140" MaxWidth="220"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="2.4*" MinWidth="220"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto" MinWidth="140"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto" MinWidth="140"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Firma" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Firmalar}"
                                  SelectedItem="{Binding SelectedFirma}"
                                  DisplayMemberPath="Ad"
                                  FontSize="14" Padding="8,6"
                                  MaxDropDownHeight="320"
                                  DropDownOpened="FilterCombo_DropDownOpened"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Rapor Türü" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Raporlar}"
                                  SelectedItem="{Binding SelectedRapor}"
                                  DisplayMemberPath="RaporAdi"
                                  FontSize="14" Padding="8,6"
                                  MaxDropDownHeight="320"
                                  DropDownOpened="FilterCombo_DropDownOpened"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Başlangıç" Style="{StaticResource FieldLabel}"/>
                        <dxe:DateEdit EditValue="{Binding Baslangic}" Mask="dd.MM.yyyy" MaskUseAsDisplayFormat="True"
                                      Width="150"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Bitiş" Style="{StaticResource FieldLabel}"/>
                        <dxe:DateEdit EditValue="{Binding Bitis}" Mask="dd.MM.yyyy" MaskUseAsDisplayFormat="True"
                                      Width="150"/>
                    </StackPanel>
                    <Button Grid.Column="8" Content="Getir" Style="{StaticResource PrimaryBtn}"
                            Command="{Binding GetirCommand}" MinWidth="100"
                            VerticalAlignment="Bottom"/>
                </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10"
                    Visibility="{Binding ShowMultiSelect, Converter={StaticResource BoolToVis}}"
                    MaxHeight="140">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding MultiSelectTitle}"
                               FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding MultiSelectItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Ad}"
                                              Margin="0,0,16,6" FontSize="13"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <dxg:GridControl ItemsSource="{Binding Rows}" AutoGenerateColumns="AddNew">
                        <dxg:GridControl.View>
                            <dxg:TableView Style="{StaticResource CeypassListTableView}"/>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                    <controls:CeypassEmptyState ItemsSource="{Binding Rows}"
                                                Title="Sonuç yok"
                                                Message="Filtreleri seçip Getir’e basın. Sonuç boşsa tarih veya firma seçimini değiştirin."/>
                </Grid>
            </Border>

            <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,8,0,0" Foreground="#475569"
                       TextWrapping="Wrap"/>

            <!-- Getir sonrası yükleme katmanı -->
            <controls:CeypassBusyOverlay Grid.Row="0" Grid.RowSpan="4"
                                         IsBusy="{Binding Busy}"
                                         Title="Rapor yükleniyor..."
                                         Message="Lütfen bekleyin"/>
        </Grid>
    </Border>
</UserControl>
