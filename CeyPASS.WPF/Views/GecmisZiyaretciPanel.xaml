<UserControl x:Class="CeyPASS.WPF.Views.GecmisZiyaretciPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource Brush.Card}" CornerRadius="10" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="10">
        <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" Text="Geçmiş Ziyaretçiler"
                       FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtAra" DockPanel.Dock="Top"
                     Style="{StaticResource FieldBox}"
                     Margin="0,0,0,6" Padding="8,5" FontSize="13" Height="32"/>
            <ListBox x:Name="LstGecmis" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                     Padding="2,1"
                     DisplayMemberPath="Gosterim"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="False">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource CeypassListBoxItem}">
                        <Setter Property="Padding" Value="8,2"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Height" Value="26"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
