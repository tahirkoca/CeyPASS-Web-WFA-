<UserControl x:Class="CeyPASS.WPF.Views.CihazView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CeyPASS.WPF.Controls"
             xmlns:wpf="clr-namespace:CeyPASS.WPF"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.PageBg}">
        <Grid Margin="14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,14" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Yenile" Style="{StaticResource SecondaryBtn}"
                                    Padding="10,5" Command="{Binding RefreshCommand}"
                                    IsEnabled="{Binding ListEnabled}"/>
                            <TextBlock Text="Cihaz Listesi" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Grid>
                        <ListBox ItemsSource="{Binding Items}"
                                 SelectedItem="{Binding SelectedItem, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding ListEnabled}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource CeypassListBoxItem}"/>
                        <controls:CeypassEmptyState ItemsSource="{Binding Items}"
                                                    Title="Cihaz yok"
                                                    Message="Ekle ile yeni cihaz oluşturun veya Yenile’ye basın."/>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="18,14" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                        <DockPanel>
                                                        <controls:CeypassHelpTip DockPanel.Dock="Right" Topic="Cihazlar"
                                                     VerticalAlignment="Center" Margin="8,0,0,0"/>
<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="BtnEkle" Content="Ekle" Style="{StaticResource AddBtn}" Margin="0,0,8,0"
                                        Command="{Binding AddCommand}" IsEnabled="{Binding CanAdd}"/>
                                <Button x:Name="BtnGuncelle" Content="Güncelle" Style="{StaticResource EditBtn}" Margin="0,0,8,0"
                                        Command="{Binding EditCommand}" IsEnabled="{Binding CanEdit}"/>
                                <Button x:Name="BtnSil" Content="Sil" Style="{StaticResource DangerBtn}"
                                        Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDelete}"/>
                            </StackPanel>
                            <TextBlock Text="Cihaz Bilgileri" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,18">
                        <StackPanel>
                            <TextBlock Text="{Binding Error}" Foreground="#DC2626" TextWrapping="Wrap"
                                       Margin="0,0,0,12" FontSize="13"/>

                            <TextBlock Text="Cihaz Id" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding CihazIdText, Mode=OneWay}" Style="{StaticResource FieldBox}"
                                     IsReadOnly="True" MaxWidth="200"
                                     wpf:FieldValidation.Error="{Binding Errors[CihazId]}"
                                     HorizontalAlignment="Left" Margin="0,0,0,14"/>

                            <TextBlock Text="Firma Id" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding FirmaIdText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldBox}"
                                     IsReadOnly="{Binding FirmaIdReadOnly}" MaxWidth="200"
                                     HorizontalAlignment="Left" Margin="0,0,0,14"/>

                            <TextBlock Text="Cihaz Adı" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding CihazAdi, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldBox}"
                                     IsReadOnly="{Binding FieldsReadOnly}"
                                     wpf:FieldValidation.Error="{Binding Errors[CihazAdi]}"
                                     Margin="0,0,0,14"/>

                            <TextBlock Text="IP Adres" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding IpAdres, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldBox}"
                                     IsReadOnly="{Binding FieldsReadOnly}"
                                     wpf:FieldValidation.Error="{Binding Errors[IpAdres]}"
                                     Margin="0,0,0,14"/>

                            <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldBox}" Width="120"
                                     HorizontalAlignment="Left"
                                     IsReadOnly="{Binding FieldsReadOnly}" Margin="0,0,0,14"/>

                            <TextBlock Text="Açıklama" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Aciklama, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldBox}"
                                     IsReadOnly="{Binding FieldsReadOnly}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"
                                     Margin="0,0,0,14"/>

                            <TextBlock Text="Cihaz Tipi" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Tipler}"
                                      SelectedItem="{Binding SelectedTip}"
                                      DisplayMemberPath="TipAdi"
                                      IsEnabled="{Binding TipEnabled}"
                                      Style="{StaticResource FieldCombo}"
                                      wpf:FieldValidation.Error="{Binding Errors[SelectedTip]}"
                                      Margin="0,0,0,14" MaxWidth="320" HorizontalAlignment="Left"/>

                            <CheckBox Content="Yemek saat penceresi aktif"
                                      IsChecked="{Binding SaatPenceresiAktifMi}"
                                      IsEnabled="{Binding SaatPenceresiEnabled}"
                                      FontSize="13.5" Margin="0,0,0,10"/>

                            <CheckBox Content="Ana giriş/çıkış (Danışma / normal Canlı İzleme)"
                                      IsChecked="{Binding AnaGirisCikisMi}"
                                      IsEnabled="{Binding SaatPenceresiEnabled}"
                                      FontSize="13.5" Margin="0,0,0,10"/>

                            <CheckBox Content="Araç giriş/çıkış (ARAÇ Canlı İzleme)"
                                      IsChecked="{Binding AracGirisCikisMi}"
                                      IsEnabled="{Binding SaatPenceresiEnabled}"
                                      FontSize="13.5"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="18,14" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                            Visibility="{Binding ShowSaveCancel, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Vazgeç" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"
                                    Command="{Binding CancelCommand}"/>
                            <Button Content="Kaydet" Style="{StaticResource PrimaryBtn}"
                                    Command="{Binding SaveCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
