<local:CeypassThemedWindow x:Class="CeyPASS.WPF.Views.CanliIzlemeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:local="clr-namespace:CeyPASS.WPF"
        xmlns:controls="clr-namespace:CeyPASS.WPF.Controls"
        Title="Canlı İzleme"
        Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FontFamily="Segoe UI"
        Closing="Window_OnClosing">
    <local:CeypassThemedWindow.HeaderItems>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
            <controls:CeypassThemeToggle Margin="0,0,6,0"/>
            <controls:CeypassWindowChrome Variant="Light"/>
        </StackPanel>
    </local:CeypassThemedWindow.HeaderItems>
    <Grid x:Name="RootLayout" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="CardsRow" Height="1.2*"/>
            <RowDefinition x:Name="MovesRowDef" Height="*"/>
        </Grid.RowDefinitions>

        <!-- Son geçenler -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Card}" Margin="0,0,0,8" Padding="8">
            <ItemsControl x:Name="LastPassCards">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="10" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                CornerRadius="6" ClipToBounds="True"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Margin="8,8,8,4" Background="Transparent"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        ClipToBounds="True">
                                    <Image Source="{Binding Photo}" Stretch="Uniform"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                </Border>

                                <TextBlock Grid.Row="1" Text="{Binding AdSoyad}"
                                           FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           HorizontalAlignment="Stretch"
                                           Margin="12,4,12,8"/>

                                <Border Grid.Row="2" Background="{Binding YonBg}" Padding="10,12"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Stretch">
                                        <TextBlock Text="{Binding YonText}"
                                                   FontSize="18" FontWeight="Bold" Foreground="White"
                                                   TextAlignment="Center" HorizontalAlignment="Stretch"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding ZamanText}"
                                                   FontSize="14" Foreground="White"
                                                   TextAlignment="Center" HorizontalAlignment="Stretch"/>
                                        <TextBlock Text="{Binding Terminal}"
                                                   FontSize="14" Foreground="White"
                                                   TextAlignment="Center" HorizontalAlignment="Stretch"
                                                   Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Sol: Son hareketler | Sağ: Atama listesi -->
        <Grid x:Name="HareketPanel" Grid.Row="1" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource Brush.Card}" Margin="0,0,4,0" Padding="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Son Hareketler" FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource Brush.TextPrimary}" Margin="6,4,6,6"/>
                    <dxg:GridControl x:Name="HareketGrid" Grid.Row="1"
                                     AutoGenerateColumns="AddNew"
                                     SelectedItemChanged="HareketGrid_OnSelectedItemChanged">
                        <dxg:GridControl.View>
                            <dxg:TableView Style="{StaticResource CeypassTableView}" AutoWidth="True"
                                           ShowAutoFilterRow="False"/>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource Brush.Card}" Margin="4,0,0,0" Padding="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="6,4,6,6" LastChildFill="False">
                        <TextBlock Text="Kart Atamaları" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   VerticalAlignment="Center" DockPanel.Dock="Left"
                                   Margin="0,0,6,0"/>
                        <controls:CeypassHelpTip Topic="CanliIzlemeKartAtama"
                                                 DockPanel.Dock="Left"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"/>
                        <Button x:Name="BtnKartDurumToplu"
                                Content="Kart durumları"
                                Padding="10,3"
                                Margin="0,0,8,0"
                                DockPanel.Dock="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource SecondaryBtn}"
                                Click="BtnKartDurumToplu_OnClick"
                                ToolTip="Kartların serbest/kısıtlı durumunu görüntüle ve toplu yönet"/>
                        <ComboBox x:Name="CmbAtamaTip"
                                  Width="160"
                                  DockPanel.Dock="Right"
                                  VerticalAlignment="Center"
                                  SelectionChanged="CmbAtamaTip_OnSelectionChanged"/>
                    </DockPanel>
                    <dxg:GridControl x:Name="AtamaGrid" Grid.Row="1"
                                     AutoGenerateColumns="None"
                                     MouseDoubleClick="AtamaGrid_OnMouseDoubleClick">
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="KartAdi" Header="Kart" Width="*" MinWidth="140"/>
                            <dxg:GridColumn FieldName="MisafirAdSoyad" Header="Kişi / Plaka" Width="*" MinWidth="140"/>
                            <dxg:GridColumn FieldName="DurumText" Header="Durum" Width="100" FixedWidth="True"
                                            HorizontalHeaderContentAlignment="Center"/>
                            <dxg:GridColumn Header="İşlem" Width="260" FixedWidth="True"
                                            HorizontalHeaderContentAlignment="Center">
                                <dxg:GridColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="2,0">
                                            <Button Content="Kartı Kısıtla" Padding="8,3" Margin="0,0,4,0"
                                                    Style="{StaticResource DangerBtn}"
                                                    IsEnabled="{Binding RowData.Row.CanPasifEt}"
                                                    Tag="{Binding RowData.Row}"
                                                    Click="BtnSatirKartPasif_OnClick"/>
                                            <Button Content="Kart Kısıtı Kaldır" Padding="8,3"
                                                    Style="{StaticResource SuccessBtn}"
                                                    IsEnabled="{Binding RowData.Row.CanAktifEt}"
                                                    Tag="{Binding RowData.Row}"
                                                    Click="BtnSatirKartAktif_OnClick"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </dxg:GridColumn.CellTemplate>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="AtamaTableView"
                                           Style="{StaticResource CeypassTableView}"
                                           AutoWidth="True"
                                           AllowEditing="False"
                                           ShowGroupPanel="False"
                                           ShowAutoFilterRow="False"
                                           NavigationStyle="Row"
                                           RowDoubleClick="AtamaTableView_OnRowDoubleClick">
                                <dxg:TableView.FormatConditions>
                                    <dxg:FormatCondition FieldName="DurumText" Expression="[DurumText] = 'HAZIR'">
                                        <dxg:FormatCondition.Format>
                                            <dx:Format Background="#E67E22" Foreground="White"/>
                                        </dxg:FormatCondition.Format>
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition FieldName="DurumText" Expression="[DurumText] = 'ATANMIŞ'">
                                        <dxg:FormatCondition.Format>
                                            <dx:Format Background="#47698A" Foreground="White"/>
                                        </dxg:FormatCondition.Format>
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition FieldName="DurumText" Expression="[DurumText] = 'GİRİŞ'">
                                        <dxg:FormatCondition.Format>
                                            <dx:Format Background="#2E8B57" Foreground="White"/>
                                        </dxg:FormatCondition.Format>
                                    </dxg:FormatCondition>
                                    <dxg:FormatCondition FieldName="DurumText" Expression="[DurumText] = 'ÇIKIŞ'">
                                        <dxg:FormatCondition.Format>
                                            <dx:Format Background="#B22222" Foreground="White"/>
                                        </dxg:FormatCondition.Format>
                                    </dxg:FormatCondition>
                                </dxg:TableView.FormatConditions>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                    </dxg:GridControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</local:CeypassThemedWindow>
