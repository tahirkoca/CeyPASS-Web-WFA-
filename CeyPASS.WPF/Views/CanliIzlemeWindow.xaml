<local:CeypassThemedWindow x:Class="CeyPASS.WPF.Views.CanliIzlemeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:local="clr-namespace:CeyPASS.WPF"
        xmlns:controls="clr-namespace:CeyPASS.WPF.Controls"
        Title="Canlı İzleme"
        Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FontFamily="Segoe UI"
        Closing="Window_OnClosing">
    <local:CeypassThemedWindow.HeaderItems>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
            <controls:CeypassThemeToggle Margin="0,0,6,0"/>
            <controls:CeypassWindowChrome Variant="Light"/>
        </StackPanel>
    </local:CeypassThemedWindow.HeaderItems>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="1.2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Son geçenler — WFA KisiKartKontrolu: foto üstte, alt şerit Giriş=SeaGreen / Çıkış=Firebrick -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Card}" Margin="0,0,0,8" Padding="8">
            <ItemsControl x:Name="LastPassCards">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="10" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                CornerRadius="6" ClipToBounds="True"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Margin="16,14,16,8" Background="Transparent"
                                        MinHeight="160" MaxHeight="220"
                                        HorizontalAlignment="Stretch">
                                    <Image Source="{Binding Photo}" Stretch="Uniform"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Row="1" Text="{Binding AdSoyad}"
                                           FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           HorizontalAlignment="Stretch"
                                           Margin="12,0,12,4"/>
                                <TextBlock Grid.Row="2" Text="{Binding Departman}"
                                           FontSize="12.5" FontStyle="Italic" Foreground="{DynamicResource Brush.TextMuted}"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           HorizontalAlignment="Stretch"
                                           Margin="12,0,12,2"/>
                                <TextBlock Grid.Row="3" Text="{Binding Unvan}"
                                           FontSize="12.5" FontStyle="Italic" Foreground="{DynamicResource Brush.TextMuted}"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           HorizontalAlignment="Stretch"
                                           Margin="12,0,12,10"/>

                                <!-- Belirgin Giriş (yeşil) / Çıkış (kırmızı) şeridi -->
                                <Border Grid.Row="4" Background="{Binding YonBg}" Padding="8,10"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Stretch">
                                        <TextBlock Text="{Binding YonText}"
                                                   FontSize="16" FontWeight="Bold" Foreground="White"
                                                   TextAlignment="Center" HorizontalAlignment="Stretch"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding ZamanText}"
                                                   FontSize="13" Foreground="White"
                                                   TextAlignment="Center" HorizontalAlignment="Stretch"/>
                                        <TextBlock Text="{Binding Terminal}"
                                                   FontSize="13" Foreground="White"
                                                   TextAlignment="Center" HorizontalAlignment="Stretch"
                                                   Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Hareketler + seçili kişi (WFA: ortalı) -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource Brush.Card}" Margin="0,0,8,0" Padding="4">
                <dxg:GridControl x:Name="HareketGrid"
                                 AutoGenerateColumns="AddNew"
                                 SelectedItemChanged="HareketGrid_OnSelectedItemChanged">
                    <dxg:GridControl.View>
                        <dxg:TableView Style="{StaticResource CeypassTableView}" AutoWidth="True"/>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource Brush.Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="Transparent" Margin="0,0,0,10"
                            MinHeight="180" HorizontalAlignment="Stretch">
                        <Image x:Name="ImgSecili" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="8"/>
                    </Border>

                    <TextBlock Grid.Row="1" x:Name="LblSeciliAd" Text="-"
                               FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"
                               TextAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Stretch" Margin="8,0,8,8"/>
                    <TextBlock Grid.Row="2" x:Name="LblSeciliDepartman" Text="-"
                               FontSize="13.5" FontStyle="Italic" Foreground="{DynamicResource Brush.TextMuted}"
                               TextAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Stretch" Margin="8,0,8,6"/>
                    <TextBlock Grid.Row="3" x:Name="LblSeciliUnvan" Text="-"
                               FontSize="13.5" FontStyle="Italic" Foreground="{DynamicResource Brush.TextMuted}"
                               TextAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Stretch" Margin="8,0,8,4"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Kart butonları -->
        <Border x:Name="KartButonlariPanel" Grid.Row="2" Background="{DynamicResource Brush.Card}" Padding="10,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnKisiyeKartAta" Content="Kişiye Kart Ata" Width="160" Height="36" Margin="0,0,8,0"
                        Style="{StaticResource PrimaryBtn}"
                        Click="BtnKisiyeKartAta_OnClick"/>
                <Button x:Name="BtnAtananKartGuncelle" Content="Atanan Kartı Güncelle" Width="180" Height="36" Margin="0,0,8,0"
                        Style="{StaticResource PrimaryBtn}"
                        Click="BtnAtananKartGuncelle_OnClick"/>
                <Button x:Name="BtnAracKartiVer" Content="Araç Kartı Ver" Width="150" Height="36" Margin="0,0,8,0"
                        Style="{StaticResource SuccessBtn}"
                        Click="BtnAracKartiVer_OnClick"/>
                <Button x:Name="BtnAracKartiGuncelle" Content="Araç Kartı Güncelle" Width="170" Height="36"
                        Style="{StaticResource SuccessBtn}"
                        Click="BtnAracKartiGuncelle_OnClick"/>
            </StackPanel>
        </Border>
    </Grid>
</local:CeypassThemedWindow>
