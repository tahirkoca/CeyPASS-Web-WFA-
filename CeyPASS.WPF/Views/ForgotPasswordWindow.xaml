<Window x:Class="CeyPASS.WPF.Views.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Şifremi Unuttum"
        Width="480"
        SizeToContent="Height"
        MinHeight="420"
        MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        MouseLeftButtonDown="Window_OnMouseLeftButtonDown">
    <Window.Resources>
        <Style x:Key="DialogFieldBox" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="DialogFieldPassword" TargetType="PasswordBox" BasedOn="{StaticResource FieldPassword}">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Brush.Card}" CornerRadius="16" Margin="12"
            BorderThickness="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.22" Color="#0F172A"/>
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="5" Background="#2563EB"
                    CornerRadius="16,16,0,0"/>

            <Border DockPanel.Dock="Bottom" Padding="22,0,22,20">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="Kapatmak için" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                                   VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource Brush.SecondaryBg}" CornerRadius="5"
                                Padding="7,2" Margin="7,0"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <TextBlock Text="Esc" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.SecondaryFg}"/>
                        </Border>
                        <TextBlock Text="tuşuna basın" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Vazgeç" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"
                                IsCancel="True" Click="BtnVazgec_OnClick"/>
                        <Button x:Name="BtnKaydet" Content="Kaydet" Style="{StaticResource PrimaryBtn}"
                                Click="BtnKaydet_OnClick" IsDefault="True"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Margin="22,18,22,12">
                <TextBlock Text="Şifre Sıfırlama" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                <TextBlock x:Name="LblInfo" Text="Doğrulama kodu e-posta adresinize gönderildi."
                           FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,6,0,16" TextWrapping="Wrap"/>
                <TextBlock x:Name="LblError" Foreground="#DC2626" FontSize="12.5" TextWrapping="Wrap"
                           Margin="0,0,0,10" Visibility="Collapsed"/>

                <Border Background="{DynamicResource Brush.DialogSoft}" CornerRadius="12" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Doğrulama Kodu" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtKod" Style="{StaticResource DialogFieldBox}"/>

                        <TextBlock Text="Yeni Şifre" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="PwdYeni" Style="{StaticResource DialogFieldPassword}"/>

                        <TextBlock Text="Yeni Şifre (Tekrar)" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="PwdYeniTekrar" Style="{StaticResource DialogFieldPassword}" Margin="0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
