<Window x:Class="CeyPASS.WPF.Views.CanliIzlemeLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Canlı İzleme Ekranı Giriş"
        Width="480"
        SizeToContent="Height"
        MinHeight="420"
        MinWidth="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        FontFamily="Segoe UI"
        Closing="Window_OnClosing"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        MouseLeftButtonDown="Window_OnMouseLeftButtonDown">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="90"/>
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsEditable" Value="False"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Brush.Card}" CornerRadius="16" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.22" Color="#0F172A"/>
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="5" Background="#2563EB"
                    CornerRadius="16,16,0,0"/>

            <Border DockPanel.Dock="Bottom" Padding="18,0,18,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Giriş ekranına dönmek için" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                               VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource Brush.SecondaryBg}" CornerRadius="5"
                            Padding="7,2" Margin="7,0"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <TextBlock Text="Esc" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.SecondaryFg}"/>
                    </Border>
                    <TextBlock Text="veya Geri butonuna basınız" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <StackPanel Margin="28,16,28,8">
                <Grid Margin="0,0,0,12">
                    <Button HorizontalAlignment="Left" VerticalAlignment="Top"
                            ToolTip="Giriş ekranına dön"
                            Click="BtnGeri_OnClick"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Width="36" Height="36">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{DynamicResource Brush.SecondaryBg}"
                                        CornerRadius="18" Width="36" Height="36"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.SecondaryHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,18">
                    <Image Source="pack://application:,,,/Assets/ceyLogo.png" Height="48" Stretch="Uniform" Margin="0,0,0,10"/>
                    <TextBlock Text="Canlı İzleme Girişi" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}"/>
                    <TextBlock Text="Canlı izleme ekranına bağlanmak için bilgilerinizi girin."
                               FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Bölge" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Grid.Column="1" x:Name="CmbBolge" Style="{StaticResource FieldCombo}"
                              DisplayMemberPath="FirmaAdi"
                              SelectionChanged="CmbBolge_OnSelectionChanged"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Kullanıcı" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Grid.Column="1" x:Name="CmbKullanici" Style="{StaticResource FieldCombo}"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Şifre" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox Grid.Column="1" x:Name="PwdBox" Height="36" FontSize="13" Padding="6,4"
                                 VerticalContentAlignment="Center"/>
                </Grid>

                <TextBlock x:Name="LblError" Foreground="#C83232" Margin="0,4,0,12"
                           TextWrapping="Wrap" MinHeight="20" FontSize="12.5"/>

                <Button Content="GİRİŞ" Height="44" Click="BtnGiris_OnClick" Cursor="Hand"
                        Background="#C83232" Foreground="White" FontWeight="Bold" FontSize="14"
                        BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#B42828"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
