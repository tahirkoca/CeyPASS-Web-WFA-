<UserControl x:Class="CeyPASS.WPF.Views.GuncellemeBildirimView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CeyPASS.WPF.Controls"
             xmlns:wpf="clr-namespace:CeyPASS.WPF"
             Background="Transparent">
    <Grid>
    <Border Background="{DynamicResource Brush.PageBg}">
        <DockPanel Margin="12">
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Card}" Padding="14,12"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Önizleme" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"
                            Command="{Binding PreviewCommand}" IsEnabled="{Binding CanPreview}"/>
                    <Button Content="Gönder" Style="{StaticResource PrimaryBtn}"
                            Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}"/>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding Error}" Foreground="#DC2626" TextWrapping="Wrap"
                               Margin="0,0,0,8" FontSize="13"/>

                    <TextBlock Text="Güncelleme Bildirimi" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,12"/>

                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Versiyon" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Versiyon, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FieldBox}"
                                         wpf:FieldValidation.Error="{Binding Errors[Versiyon]}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Yayın Tarihi" Style="{StaticResource FieldLabel}"/>
                                <DatePicker SelectedDate="{Binding YayinTarihi}"
                                            Style="{StaticResource FieldDatePicker}" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Güncelleme Tipi" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding TipSecenekleri}"
                                          SelectedItem="{Binding GuncellemeTipi}"
                                          Style="{StaticResource FieldCombo}"
                                          wpf:FieldValidation.Error="{Binding Errors[GuncellemeTipi]}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                        <TabControl>
                            <TabItem Header="Yeni Özellikler">
                                <DockPanel Margin="8">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="Ekle" Style="{StaticResource SuccessBtn}"
                                                Margin="8,0,0,0" Command="{Binding AddYeniCommand}"/>
                                        <Button DockPanel.Dock="Right" Content="Sil" Style="{StaticResource DangerBtn}"
                                                Command="{Binding RemoveYeniCommand}"/>
                                        <TextBox Text="{Binding YeniOzellikText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FieldBox}"
                                                 wpf:FieldValidation.Error="{Binding Errors[YeniOzellikText]}"/>
                                    </DockPanel>
                                    <ListBox ItemsSource="{Binding YeniOzellikler}"
                                             SelectedItem="{Binding SelectedYeni}" MinHeight="160"
                                             ItemContainerStyle="{StaticResource CeypassListBoxItem}"/>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="İyileştirmeler">
                                <DockPanel Margin="8">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="Ekle" Style="{StaticResource SuccessBtn}"
                                                Margin="8,0,0,0" Command="{Binding AddIyilestirmeCommand}"/>
                                        <Button DockPanel.Dock="Right" Content="Sil" Style="{StaticResource DangerBtn}"
                                                Command="{Binding RemoveIyilestirmeCommand}"/>
                                        <TextBox Text="{Binding IyilestirmeText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FieldBox}"
                                                 wpf:FieldValidation.Error="{Binding Errors[IyilestirmeText]}"/>
                                    </DockPanel>
                                    <ListBox ItemsSource="{Binding Iyilestirmeler}"
                                             SelectedItem="{Binding SelectedIyilestirme}" MinHeight="160"
                                             ItemContainerStyle="{StaticResource CeypassListBoxItem}"/>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Hata Düzeltmeleri">
                                <DockPanel Margin="8">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="Ekle" Style="{StaticResource SuccessBtn}"
                                                Margin="8,0,0,0" Command="{Binding AddHataCommand}"/>
                                        <Button DockPanel.Dock="Right" Content="Sil" Style="{StaticResource DangerBtn}"
                                                Command="{Binding RemoveHataCommand}"/>
                                        <TextBox Text="{Binding HataDuzeltmeText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FieldBox}"
                                                 wpf:FieldValidation.Error="{Binding Errors[HataDuzeltmeText]}"/>
                                    </DockPanel>
                                    <ListBox ItemsSource="{Binding HataDuzeltmeleri}"
                                             SelectedItem="{Binding SelectedHata}" MinHeight="160"
                                             ItemContainerStyle="{StaticResource CeypassListBoxItem}"/>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Kritik Değişiklikler">
                                <DockPanel Margin="8">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="Ekle" Style="{StaticResource SuccessBtn}"
                                                Margin="8,0,0,0" Command="{Binding AddKritikCommand}"/>
                                        <Button DockPanel.Dock="Right" Content="Sil" Style="{StaticResource DangerBtn}"
                                                Command="{Binding RemoveKritikCommand}"/>
                                        <TextBox Text="{Binding KritikDegisiklikText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FieldBox}"
                                                 wpf:FieldValidation.Error="{Binding Errors[KritikDegisiklikText]}"/>
                                    </DockPanel>
                                    <ListBox ItemsSource="{Binding KritikDegisiklikler}"
                                             SelectedItem="{Binding SelectedKritik}" MinHeight="160"
                                             ItemContainerStyle="{StaticResource CeypassListBoxItem}"/>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Ek Notlar" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding EkNotlar, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldBox}" AcceptsReturn="True"
                                     TextWrapping="Wrap" MinHeight="80"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
    <controls:CeypassBusyOverlay IsBusy="{Binding Busy}"
                                 Title="Gönderiliyor..."
                                 Message="Lütfen bekleyin"/>
    </Grid>
</UserControl>
