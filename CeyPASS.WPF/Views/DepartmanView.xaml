<UserControl x:Class="CeyPASS.WPF.Views.DepartmanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CeyPASS.WPF.Controls"
             xmlns:wpf="clr-namespace:CeyPASS.WPF"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.PageBg}">
        <Grid Margin="14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sol liste -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,14" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Yenile" Style="{StaticResource SecondaryBtn}"
                                    Padding="10,5" Command="{Binding RefreshCommand}"
                                    IsEnabled="{Binding ListEnabled}"/>
                            <TextBlock Text="Departman Listesi" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Grid>
                        <ListBox ItemsSource="{Binding Items}"
                                 SelectedItem="{Binding SelectedItem, UpdateSourceTrigger=PropertyChanged}"
                                 DisplayMemberPath="Ad"
                                 IsEnabled="{Binding ListEnabled}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource CeypassListBoxItem}"/>
                        <controls:CeypassEmptyState ItemsSource="{Binding Items}"
                                                    Title="Departman yok"
                                                    Message="Ekle ile yeni departman oluşturun veya Yenile’ye basın."/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Sağ form -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="18,14" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                        <DockPanel>
                                                        <controls:CeypassHelpTip DockPanel.Dock="Right" Topic="Departmanlar"
                                                     VerticalAlignment="Center" Margin="8,0,0,0"/>
<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="BtnEkle" Content="Ekle" Style="{StaticResource AddBtn}" Margin="0,0,8,0"
                                        Command="{Binding AddCommand}"/>
                                <Button x:Name="BtnGuncelle" Content="Güncelle" Style="{StaticResource EditBtn}" Margin="0,0,8,0"
                                        Command="{Binding EditCommand}"/>
                                <Button x:Name="BtnSil" Content="Sil" Style="{StaticResource DangerBtn}"
                                        Command="{Binding DeleteCommand}"/>
                            </StackPanel>
                            <TextBlock Text="Departman Bilgileri" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,18">
                        <StackPanel>
                            <TextBlock Text="{Binding Error}" Foreground="#DC2626" TextWrapping="Wrap"
                                       Margin="0,0,0,12" FontSize="13"/>

                            <TextBlock Text="Id" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding IdText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Style="{StaticResource FieldBox}"
                                     IsReadOnly="{Binding IdReadOnly, Mode=OneWay}"
                                     wpf:FieldValidation.Error="{Binding Errors[Id]}"
                                     MaxWidth="200" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                            <TextBlock Text="Adı" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Ad, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Style="{StaticResource FieldBox}"
                                     IsReadOnly="{Binding FieldsReadOnly, Mode=OneWay}"
                                     wpf:FieldValidation.Error="{Binding Errors[Ad]}"
                                     Margin="0,0,0,16"/>

                            <TextBlock Text="Açıklama" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Aciklama, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Style="{StaticResource FieldBox}"
                                     IsReadOnly="{Binding FieldsReadOnly, Mode=OneWay}"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="140" Height="160"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="18,14" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                            Visibility="{Binding ShowSaveCancel, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Vazgeç" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"
                                    Command="{Binding CancelCommand}"/>
                            <Button Content="Kaydet" Style="{StaticResource PrimaryBtn}"
                                    Command="{Binding SaveCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
