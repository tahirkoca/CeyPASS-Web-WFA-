<Window x:Class="CeyPASS.WPF.Views.KisiAraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        Title="Personel Ara"
        Width="1140" Height="680"
        MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        MouseLeftButtonDown="Window_OnMouseLeftButtonDown">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="DialogFieldBox" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Brush.Card}" CornerRadius="16" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.22" Color="#0F172A"/>
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="5" Background="#2563EB"
                    CornerRadius="16,16,0,0"/>

            <Border DockPanel.Dock="Bottom" Padding="18,0,18,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Kapatmak için" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                                   VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource Brush.SecondaryBg}" CornerRadius="5"
                                Padding="7,2" Margin="7,0"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <TextBlock Text="Esc" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.SecondaryFg}"/>
                        </Border>
                        <TextBlock Text="tuşuna basın" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Vazgeç" Style="{StaticResource SecondaryBtn}"
                                IsCancel="True" Click="BtnVazgec_OnClick" Padding="16,8" Margin="0,0,8,0"/>
                        <Button Content="Personel Seç" Style="{StaticResource PrimaryBtn}"
                                Command="{Binding SelectCommand}" Padding="16,8"/>
                    </StackPanel>
                    <TextBlock/>
                </DockPanel>
            </Border>

            <Grid Margin="18,14,18,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Personel Ara" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                    <TextBlock Text="Filtreleyin, listeden seçin ve Personel Seç ile onaylayın."
                               FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Background="{DynamicResource Brush.PageBg}" CornerRadius="12"
                        Padding="14,12" Margin="0,0,0,12"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <WrapPanel>
                        <StackPanel Margin="0,0,16,0" Width="200">
                            <TextBlock Text="Firma" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Firmalar}" DisplayMemberPath="FirmaAdi"
                                      SelectedItem="{Binding SelectedFirma}" Height="32"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0" Width="180">
                            <TextBlock Text="İşyeri" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Isyerler}" DisplayMemberPath="Ad"
                                      SelectedItem="{Binding SelectedIsyeri}" Height="32"/>
                        </StackPanel>
                        <CheckBox Content="İşten Çıkanlar" IsChecked="{Binding IstenCikanlar}"
                                  VerticalAlignment="Center" Margin="0,16,16,0"/>
                        <CheckBox Content="Puantaj Yapılanlar" IsChecked="{Binding PuantajYapilan}"
                                  IsEnabled="{Binding KartTipiEnabled}"
                                  VerticalAlignment="Center" Margin="0,16,0,0"/>
                    </WrapPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource Brush.PageBg}" CornerRadius="12"
                            Padding="12" Margin="0,0,10,0"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Temizle" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"
                                        Command="{Binding ClearCommand}"/>
                                <Button Content="Ara" Style="{StaticResource PrimaryBtn}"
                                        Command="{Binding SearchCommand}"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Ad / Soyad / Kart" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding AdSoyadKart, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DialogFieldBox}"/>
                                    <TextBlock Text="Sicil No" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Sicil, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DialogFieldBox}"/>
                                    <TextBlock Text="TC Kimlik No" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Tc, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DialogFieldBox}"/>
                                    <TextBlock Text="E-posta" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DialogFieldBox}"/>
                                    <TextBlock Text="Departman" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Departmanlar}" DisplayMemberPath="Ad"
                                              SelectedItem="{Binding SelectedDepartman}" Margin="0,0,0,10" Height="32"/>
                                    <TextBlock Text="Pozisyon" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Pozisyonlar}" DisplayMemberPath="Ad"
                                              SelectedItem="{Binding SelectedPozisyon}" Margin="0,0,0,10" Height="32"/>
                                    <TextBlock Text="Çalışma Statüsü" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Statuler}" DisplayMemberPath="Ad"
                                              SelectedItem="{Binding SelectedStatu}" Margin="0,0,0,10" Height="32"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{DynamicResource Brush.PageBg}" CornerRadius="12"
                            Padding="10" Margin="0,0,10,0"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="◀" Style="{StaticResource SecondaryBtn}" Padding="10,6"
                                            Command="{Binding PrevPageCommand}" Margin="0,0,6,0"/>
                                    <Button Content="▶" Style="{StaticResource SecondaryBtn}" Padding="10,6"
                                            Command="{Binding NextPageCommand}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                            </DockPanel>
                            <dxg:GridControl ItemsSource="{Binding Results}"
                                             SelectedItem="{Binding SelectedRow}"
                                             AutoGenerateColumns="None">
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="PersonelId" Header="Sicil No"/>
                                    <dxg:GridColumn FieldName="AdSoyad" Header="Ad Soyad"/>
                                    <dxg:GridColumn FieldName="KartNo" Header="Kart No"/>
                                    <dxg:GridColumn FieldName="TcKimlikNo" Header="TC Kimlik No"/>
                                    <dxg:GridColumn FieldName="IsyeriAdi" Header="İşyeri"/>
                                    <dxg:GridColumn FieldName="DepartmanAdi" Header="Departman"/>
                                    <dxg:GridColumn FieldName="PozisyonAdi" Header="Pozisyon"/>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TableView Style="{StaticResource CeypassTableView}" AutoWidth="True"
                                                   ShowHorizontalLines="False" ShowVerticalLines="False"
                                                   RowMinHeight="28"/>
                                </dxg:GridControl.View>
                            </dxg:GridControl>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource Brush.PageBg}" CornerRadius="12"
                            Padding="14" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <StackPanel>
                            <Border Width="160" Height="160" Background="{DynamicResource Brush.SecondaryBg}"
                                    CornerRadius="10"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Image Source="{Binding PreviewFoto}" Stretch="Uniform" Margin="6"/>
                            </Border>
                            <TextBlock Text="{Binding PreviewAd}" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding PreviewTc}" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding PreviewDepartman}" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding PreviewPozisyon}" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding PreviewStatu}" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding PreviewIsyeri}" Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
