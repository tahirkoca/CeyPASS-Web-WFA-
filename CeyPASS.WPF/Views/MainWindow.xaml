<local:CeypassThemedWindow x:Class="CeyPASS.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:local="clr-namespace:CeyPASS.WPF"
        xmlns:controls="clr-namespace:CeyPASS.WPF.Controls"
        Title="CeyPASS"
        Height="860" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FontFamily="Segoe UI">
    <local:CeypassThemedWindow.HeaderItems>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
            <controls:CeypassThemeToggle Margin="0,0,6,0"/>
            <controls:CeypassWindowChrome Variant="Light"/>
        </StackPanel>
    </local:CeypassThemedWindow.HeaderItems>
    <Window.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D3D3D3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,0,10,0"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2C3136"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarButtonTall" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Height" Value="55"/>
        </Style>
        <Style x:Key="SidebarButtonActive" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SidebarExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <ToggleButton x:Name="HeaderSite"
                                          DockPanel.Dock="Top"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Cursor="Hand"
                                          Background="Transparent" BorderThickness="0"
                                          Padding="12,10,8,8"
                                          HorizontalContentAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                                <TextBlock x:Name="Chevron" Grid.Column="1"
                                                           Text="▾" Foreground="#808080" FontSize="11"
                                                           VerticalAlignment="Center" Margin="8,0,4,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="Chevron" Property="Text" Value="▸"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <TextBlock Text="{TemplateBinding Header}"
                                           FontSize="12" FontWeight="Bold" Foreground="#808080"/>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite"
                                              Visibility="Collapsed"
                                              DockPanel.Dock="Bottom"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="294"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarBorder" Grid.Column="0" Background="#212529" ClipToBounds="True">
            <Grid>
                <DockPanel x:Name="SidebarExpandedContent">
                    <Border x:Name="LogoBand" DockPanel.Dock="Top" Background="#1A1A1A" Height="84" Margin="0,0,0,8">
                        <Image Source="pack://application:,,,/Assets/CeyPass200.png"
                               Stretch="Uniform" Margin="0,8,0,8" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>

                    <Border x:Name="UserFooter" DockPanel.Dock="Bottom" Background="#212529" Height="72" Margin="0,0,0,8">
                        <Grid Margin="10,10,28,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" Background="#404040" Margin="0,0,10,0">
                                <TextBlock x:Name="LblAvatar" Text="K" Foreground="White" FontWeight="Bold"
                                           FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel x:Name="UserTextPanel" Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="LblUserName" Text="Kullanıcı" Foreground="#D3D3D3"
                                           FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="LblUserRole" Text="Kullanıcı" Foreground="#808080"
                                           FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnLogout" Grid.Column="2" Content="Çıkış" Click="BtnLogout_OnClick"
                                    Background="Transparent" Foreground="#D3D3D3" BorderThickness="0"
                                    Cursor="Hand" Padding="8,4" VerticalAlignment="Center" FontSize="12.5"/>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="MenuScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0" Background="#212529">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkSidebarScrollBar}"/>
                        </ScrollViewer.Resources>
                        <StackPanel x:Name="MenuPanel" Margin="0,0,4,0">
                            <Button x:Name="BtnDashboard" Style="{StaticResource SidebarButtonTall}"
                                    Tag="Dashboard" Click="Menu_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="pack://application:,,,/Assets/icons8-home-25.png" Width="25" Height="25" Margin="0,0,10,0"/>
                                    <TextBlock Text="Anasayfa" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Expander x:Name="ExpPOY" Style="{StaticResource SidebarExpander}" Header="PERSONEL YÖNETİMİ">
                                <StackPanel>
                                    <Button x:Name="BtnDepartmanlar" Style="{StaticResource SidebarButton}"
                                            Tag="Departmanlar" Click="Menu_OnClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Assets/icons8-department-25.png" Width="25" Height="25" Margin="0,0,10,0"/>
                                            <TextBlock Text="Departman Tanımlama" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnPersoneller" Style="{StaticResource SidebarButton}"
                                            Tag="Personeller" Click="Menu_OnClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Assets/icons8-employee-25.png" Width="25" Height="25" Margin="0,0,10,0"/>
                                            <TextBlock Text="Personel Tanımlama" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnPozisyonlar" Style="{StaticResource SidebarButton}"
                                            Tag="Pozisyonlar" Click="Menu_OnClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Assets/icons8-title-25.png" Width="25" Height="25" Margin="0,0,10,0"/>
                                            <TextBlock Text="Pozisyon Tanımlama" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnFirmalar" Style="{StaticResource SidebarButton}"
                                            Tag="Firmalar" Click="Menu_OnClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Assets/icons8-department-25.png" Width="25" Height="25" Margin="0,0,10,0"/>
                                            <TextBlock Text="Firma Tanımlama" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnIsyerler" Style="{StaticResource SidebarButton}"
                                            Tag="Isyerler" Click="Menu_OnClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Assets/icons8-department-25.png" Width="25" Height="25" Margin="0,0,10,0"/>
                                            <TextBlock Text="İşyeri Tanımlama" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnIzinler" Style="{StaticResource SidebarButtonTall}"
                                            Tag="Izinler" Click="Menu_OnClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Assets/icons8-rest-25.png" Width="25" Height="25" Margin="0,0,10,0"/>
                                            <TextBlock Text="İzinler" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="ExpEO" Style="{StaticResource SidebarExpander}" Header="EKSTRA İŞLEMLER">
                                <StackPanel>
                                    <Button x:Name="BtnKisiHareket" Style="{StaticResource SidebarButton}"
                                            Tag="KisiHareketler" Click="Menu_OnClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Assets/icons8-run-25.png" Width="25" Height="25" Margin="0,0,10,0"/>
                                            <TextBlock Text="Kişi Hareketleri" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnAylikPuantaj" Style="{StaticResource SidebarButton}"
                                            Tag="AylikPuantaj" Click="Menu_OnClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Assets/icons8-payroll-25.png" Width="25" Height="25" Margin="0,0,10,0"/>
                                            <TextBlock Text="Aylık Puantaj" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnRaporlar" Style="{StaticResource SidebarButtonTall}"
                                            Tag="Raporlar" Click="Menu_OnClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Assets/icons8-report-25new.png" Width="25" Height="25" Margin="0,0,10,0"/>
                                            <TextBlock Text="Raporlar" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="ExpVMY" Style="{StaticResource SidebarExpander}" Header="VARDİYA YÖNETİMİ">
                                <StackPanel>
                                    <Button x:Name="BtnCalismaStatuleri" Style="{StaticResource SidebarButton}"
                                            Tag="CalismaStatuleri" Click="Menu_OnClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Assets/icons8-status-25.png" Width="25" Height="25" Margin="0,0,10,0"/>
                                            <TextBlock Text="Çalışma Statüleri" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnVardiyalar" Style="{StaticResource SidebarButton}"
                                            Tag="Vardiyalar" Click="Menu_OnClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Assets/icons8-shift-25new.png" Width="25" Height="25" Margin="0,0,10,0"/>
                                            <TextBlock Text="Vardiyalar" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="ExpAyarlar" Style="{StaticResource SidebarExpander}" Header="AYARLAR">
                                <StackPanel>
                                    <Button x:Name="BtnCihazlar" Style="{StaticResource SidebarButton}"
                                            Tag="Cihazlar" Click="Menu_OnClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Assets/icons8-tourniquet-25.png" Width="25" Height="25" Margin="0,0,10,0"/>
                                            <TextBlock Text="Cihazlar" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnResmiTatiller" Style="{StaticResource SidebarButton}"
                                            Tag="ResmiTatiller" Click="Menu_OnClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Assets/icons8-balloons-25.png" Width="25" Height="25" Margin="0,0,10,0"/>
                                            <TextBlock Text="Resmi Tatiller" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Expander>

                            <!-- Admin en sonda -->
                            <Expander x:Name="ExpAdmin" Style="{StaticResource SidebarExpander}" Header="ADMIN"
                                      Visibility="Collapsed">
                                <StackPanel>
                                    <Button x:Name="BtnAdmin" Style="{StaticResource SidebarButton}"
                                            Tag="Admin" Click="Menu_OnClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Assets/icons8-windows-update-25.png" Width="25" Height="25" Margin="0,0,10,0"/>
                                            <TextBlock Text="Admin Panel" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <DockPanel x:Name="SidebarCollapsedContent" Visibility="Collapsed">
                    <Border DockPanel.Dock="Bottom" Background="#212529" Height="72" Margin="0,0,0,8">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="36" Height="36" Background="#404040" HorizontalAlignment="Center">
                                <TextBlock x:Name="LblAvatarCollapsed" Text="K" Foreground="White" FontWeight="Bold"
                                           FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Button Content="⤴" Click="BtnLogout_OnClick"
                                    Background="Transparent" Foreground="#D3D3D3" BorderThickness="0"
                                    Cursor="Hand" FontSize="14" Margin="0,4,0,0" ToolTip="Çıkış"/>
                        </StackPanel>
                    </Border>
                </DockPanel>

                <Border x:Name="ToggleEdge" HorizontalAlignment="Right" Width="28" Background="Transparent">
                    <Button x:Name="BtnSidebarToggle" Content="◀" Click="BtnSidebarToggle_OnClick"
                            Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Background="#34383C" Foreground="White" BorderBrush="#505050" BorderThickness="1"
                            FontSize="11" Cursor="Hand" Padding="0"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="57"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource Brush.HeaderBg}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                <DockPanel Margin="16,0,12,0" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="ImgPageTitle" Width="26" Height="26" Stretch="Uniform"
                               Margin="0,0,10,0" VerticalAlignment="Center"
                               Source="pack://application:,,,/Assets/icons8-home-25.png"/>
                        <TextBlock x:Name="LblPageTitle" Text="Ana Sayfa" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnShortcuts" Click="BtnShortcuts_OnClick"
                                Width="32" Height="28" Margin="0,0,8,0" Cursor="Hand"
                                ToolTip="Kısayollar (F1 / Ctrl+/)"
                                Background="{DynamicResource Brush.SecondaryBg}"
                                Foreground="{DynamicResource Brush.SecondaryFg}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Background="{DynamicResource Brush.PageBg}" Padding="0">
                <Grid>
                    <ContentControl x:Name="ContentHost"/>
                    <StackPanel x:Name="ToastHost"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Panel.ZIndex="100"/>
                    <Border x:Name="ShortcutPanel" Visibility="Collapsed" Panel.ZIndex="200"
                            Background="#990F172A" MouseLeftButtonDown="ShortcutPanel_OnBackdropClick">
                        <Border Width="420" MaxHeight="480" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Background="{DynamicResource Brush.Card}" CornerRadius="12" Padding="20"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                MouseLeftButtonDown="ShortcutPanel_OnInnerClick">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Click="BtnCloseShortcuts_OnClick"
                                            Cursor="Hand" BorderThickness="0" Background="Transparent"
                                            Padding="6,2" FontSize="12" Width="28" Height="28"
                                            Foreground="{DynamicResource Brush.TextMuted}"
                                            ToolTip="Kapat" Content="✕"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Margin="0,0,8,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                                        <TextBlock Text="Klavye kısayolları" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"/>
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl x:Name="LstShortcuts">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,8">
                                                <Border DockPanel.Dock="Left" Background="{DynamicResource Brush.SecondaryBg}"
                                                        CornerRadius="4" Padding="8,3" Margin="0,0,12,0"
                                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                                    <TextBlock Text="{Binding Keys}" FontWeight="SemiBold" FontSize="12"
                                                               Foreground="{DynamicResource Brush.SecondaryFg}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Description}" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Row="2" Background="{DynamicResource Brush.HeaderBg}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,0">
                <DockPanel>
                    <TextBlock x:Name="LblStatusCount" DockPanel.Dock="Right" VerticalAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="LblStatusMessage" Text="Hazır" VerticalAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</local:CeypassThemedWindow>
