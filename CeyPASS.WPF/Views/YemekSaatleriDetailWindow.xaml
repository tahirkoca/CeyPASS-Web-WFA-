<Window x:Class="CeyPASS.WPF.Views.YemekSaatleriDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:wpf="clr-namespace:CeyPASS.WPF"
        Title="{Binding Title}"
        Height="580" Width="800"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        MouseLeftButtonDown="Window_OnMouseLeftButtonDown">
    <Border Background="{DynamicResource Brush.Card}" CornerRadius="16" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.22" Color="#0F172A"/>
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="5" Background="#2563EB"
                    CornerRadius="16,16,0,0"/>

            <Border DockPanel.Dock="Bottom" Padding="18,0,18,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Kapatmak için" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                                   VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource Brush.SecondaryBg}" CornerRadius="5"
                                Padding="7,2" Margin="7,0"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <TextBlock Text="Esc" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.SecondaryFg}"/>
                        </Border>
                        <TextBlock Text="tuşuna basın" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="Kapat" Style="{StaticResource SecondaryBtn}"
                            IsCancel="True" Click="BtnKapat_OnClick" Padding="16,8"/>
                    <TextBlock Text="{Binding Error}" Foreground="#B91C1C"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <Grid Margin="18,14,18,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                    <TextBlock Text="Seçili vardiya için işyeri bazlı yemek saat aralıkları"
                               FontSize="13" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,0"/>
                </StackPanel>

                <dxg:GridControl Grid.Row="1" ItemsSource="{Binding Rows}"
                                 SelectedItem="{Binding SelectedRow}"
                                 AutoGenerateColumns="None">
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="Isyeri" Header="İşyeri" Width="*"/>
                        <dxg:GridColumn FieldName="Cihaz" Header="Cihaz" Width="*"/>
                        <dxg:GridColumn FieldName="Baslangic" Header="Yemek Başlangıç" Width="110"/>
                        <dxg:GridColumn FieldName="Bitis" Header="Yemek Bitiş" Width="100"/>
                        <dxg:GridColumn FieldName="Aktif" Header="Aktif" Width="70"/>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView Style="{StaticResource CeypassTableView}"/>
                    </dxg:GridControl.View>
                </dxg:GridControl>

                <Border Grid.Row="2" Margin="0,12,0,0" Padding="14" Background="{DynamicResource Brush.DialogSoft}"
                        CornerRadius="12" IsEnabled="{Binding EditorEnabled}">
                    <WrapPanel>
                        <StackPanel Width="220" Margin="0,0,12,8">
                            <TextBlock Text="İşyeri" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Isyerleri}"
                                      SelectedItem="{Binding SelectedIsyeri}"
                                      DisplayMemberPath="Ad"/>
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,12,8">
                            <TextBlock Text="Cihaz" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Cihazlar}"
                                      SelectedItem="{Binding SelectedCihaz}"
                                      DisplayMemberPath="CihazAdi"/>
                        </StackPanel>
                        <StackPanel Width="100" Margin="0,0,12,8">
                            <TextBlock Text="Yemek Başlangıç" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding BaslangicText, UpdateSourceTrigger=LostFocus}"
                                     wpf:FieldValidation.Error="{Binding Errors[Baslangic]}"/>
                        </StackPanel>
                        <StackPanel Width="100" Margin="0,0,12,8">
                            <TextBlock Text="Yemek Bitiş" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding BitisText, UpdateSourceTrigger=LostFocus}"
                                     wpf:FieldValidation.Error="{Binding Errors[Bitis]}"/>
                        </StackPanel>
                        <StackPanel Width="80" Margin="0,0,12,8" VerticalAlignment="Bottom">
                            <CheckBox Content="Aktif" IsChecked="{Binding AktifMi}" Margin="0,0,0,6"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                            <Button Content="Ekle" Style="{StaticResource AddBtn}" Margin="0,0,8,0"
                                    Command="{Binding AddCommand}" Padding="14,8"/>
                            <Button Content="Güncelle" Style="{StaticResource EditBtn}" Margin="0,0,8,0"
                                    Command="{Binding UpdateCommand}" Padding="14,8"/>
                            <Button Content="Sil" Style="{StaticResource DangerBtn}" Margin="0,0,8,0"
                                    Command="{Binding DeleteCommand}" Padding="14,8"/>
                            <Button Content="Temizle" Style="{StaticResource SecondaryBtn}"
                                    Command="{Binding ClearCommand}" Padding="14,8"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
