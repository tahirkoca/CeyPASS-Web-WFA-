<UserControl x:Class="CeyPASS.WPF.Views.ResmiTatilView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CeyPASS.WPF.Controls"
             xmlns:wpf="clr-namespace:CeyPASS.WPF"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.PageBg}">
        <Grid Margin="14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,14" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <controls:CeypassHelpTip DockPanel.Dock="Right" Topic="ResmiTatiller"
                                                     VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <Button DockPanel.Dock="Right" Content="Yenile" Style="{StaticResource SecondaryBtn}"
                                    Padding="10,5" Command="{Binding RefreshCommand}"/>
                            <TextBlock Text="Tatil Listesi" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Grid>
                        <ListBox ItemsSource="{Binding Items}"
                                 DisplayMemberPath="ListeMetni"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource CeypassListBoxItem}"/>
                        <controls:CeypassEmptyState ItemsSource="{Binding Items}"
                                                    Title="Tatil kaydı yok"
                                                    Message="Sağdaki formdan sabit tatilleri üretin veya yeni tatil ekleyin."/>
                    </Grid>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding Error}" Foreground="#DC2626" TextWrapping="Wrap"
                               Margin="0,0,0,10" FontSize="13"/>

                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Sabit Resmi Tatiller" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Başlangıç Yılı" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding BaslangicYili, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FieldBox}"
                                             wpf:FieldValidation.Error="{Binding Errors[BaslangicYili]}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Bitiş Yılı" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding BitisYili, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FieldBox}"
                                             wpf:FieldValidation.Error="{Binding Errors[BitisYili]}"/>
                                </StackPanel>
                            </Grid>

                            <Button Content="Sabit Tatilleri Oluştur ve Aktar"
                                    Style="{StaticResource PrimaryBtn}"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding SabitAktarCommand}"
                                    IsEnabled="{Binding CanSabitAktar}"/>

                            <TextBlock Style="{StaticResource HintText}"
                                       Text="* Bu kısım her yıl tekrar eden milli bayramların (23 Nisan, 19 Mayıs vb.) verilen yıl aralığı için oluşturulmasını sağlar."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Diğer Resmi Tatil Ekleme" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,14"/>

                            <TextBlock Text="Tarih" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding EklenecekTarih}"
                                        Style="{StaticResource FieldDatePicker}"
                                        FontSize="14" Margin="0,0,0,14"
                                        HorizontalAlignment="Left" Width="220"
                                        wpf:FieldValidation.Error="{Binding Errors[EklenecekTarih]}"/>

                            <TextBlock Text="Tatil Adı" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding EklenecekAd, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldBox}" Margin="0,0,0,14"/>

                            <TextBlock Text="Çalışma Saati" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding CalismaSaatiText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldBox}" Width="140"
                                     HorizontalAlignment="Left" Margin="0,0,0,14"
                                     wpf:FieldValidation.Error="{Binding Errors[CalismaSaati]}"/>

                            <Button Content="Listeye Ekle"
                                    Style="{StaticResource SuccessBtn}"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding TekilEkleCommand}"
                                    IsEnabled="{Binding CanTekilEkle}"/>

                            <TextBlock Style="{StaticResource HintText}"
                                       Text="* Dini bayramlar ve özel günler için kullanılır. Çalışma saati girerek yarım gün tatilleri tanımlayabilirsiniz."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
