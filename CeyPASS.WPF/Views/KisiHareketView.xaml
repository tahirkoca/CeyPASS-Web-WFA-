<UserControl x:Class="CeyPASS.WPF.Views.KisiHareketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:controls="clr-namespace:CeyPASS.WPF.Controls"
             xmlns:local="clr-namespace:CeyPASS.WPF.Views"
             xmlns:wpf="clr-namespace:CeyPASS.WPF"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sol: personel listesi -->
        <Border Grid.Column="0"
                Style="{StaticResource Card}"
                Margin="0,0,10,0"
                Padding="12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Personeller" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>

                    <TextBlock Text="Firma" Style="{StaticResource FieldLabel}"
                               Visibility="{Binding ShowFirmaCombo, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox ItemsSource="{Binding Firmalar}"
                              SelectedItem="{Binding SelectedFirma}"
                              DisplayMemberPath="FirmaAdi"
                              Style="{StaticResource FieldCombo}"
                              Margin="0,0,0,8"
                              Visibility="{Binding ShowFirmaCombo, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Text="İşyeri" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Isyerleri}"
                              SelectedItem="{Binding SelectedIsyeri}"
                              DisplayMemberPath="Ad"
                              Style="{StaticResource FieldCombo}"
                              Margin="0,0,0,8"/>

                    <TextBlock Text="Kart Tipi" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding KartTipleri}"
                              SelectedItem="{Binding KartTipi}"
                              Style="{StaticResource FieldCombo}"
                              Margin="0,0,0,8"/>
                </StackPanel>

                <Button DockPanel.Dock="Bottom"
                        Content="Listeyi Yenile"
                        Style="{StaticResource SecondaryBtn}"
                        Margin="0,8,0,0"
                        Command="{Binding LoadPersonsCommand}"/>

                <Grid>
                    <ListBox ItemsSource="{Binding Persons}"
                             BorderBrush="{DynamicResource Brush.Border}"
                             Background="{DynamicResource Brush.FieldBg}"
                             Foreground="{DynamicResource Brush.FieldFg}"
                             BorderThickness="1"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             ItemContainerStyle="{StaticResource CeypassListBoxItem}"
                             wpf:FieldValidation.Error="{Binding Errors[Persons]}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Ad}" Margin="2"
                                          Foreground="{DynamicResource Brush.TextPrimary}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <controls:CeypassEmptyState ItemsSource="{Binding Persons}"
                                                Title="Personel yok"
                                                Message="{Binding Status, FallbackValue=Firma / işyeri seçip Listeyi Yenile’ye basın.}"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Sağ: filtreler + grid -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <DockPanel Margin="0,0,0,10">
                        <controls:CeypassHelpTip DockPanel.Dock="Right" Topic="KisiHareket"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Kişi Hareketleri"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <WrapPanel Margin="0,0,0,10">
                        <StackPanel Margin="0,0,16,8" Width="180">
                            <TextBlock Text="Başlangıç" Style="{StaticResource FieldLabel}"/>
                            <dxe:DateEdit EditValue="{Binding Baslangic}"
                                          Mask="dd.MM.yyyy HH:mm"
                                          MaskUseAsDisplayFormat="True"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,16,8" Width="180">
                            <TextBlock Text="Bitiş" Style="{StaticResource FieldLabel}"/>
                            <dxe:DateEdit EditValue="{Binding Bitis}"
                                          Mask="dd.MM.yyyy HH:mm"
                                          MaskUseAsDisplayFormat="True"/>
                        </StackPanel>
                    </WrapPanel>

                    <WrapPanel Margin="0,4,0,10">
                        <CheckBox Content="Aktif Hareketler" IsChecked="{Binding Aktif}" Margin="0,0,16,0"/>
                        <CheckBox Content="Pasif Hareketler" IsChecked="{Binding Pasif}" Margin="0,0,16,0"/>
                        <CheckBox Content="Yemekhane Hareketleri" IsChecked="{Binding Yemekhane}"/>
                    </WrapPanel>

                    <TextBlock Text="Seçilen personelin tüm firmalardaki hareketleri listelenir."
                               Foreground="{DynamicResource Brush.TextMuted}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="Hareketleri Getir"
                                Style="{StaticResource PrimaryBtn}"
                                Command="{Binding LoadGridCommand}"
                                Margin="0,0,8,0"
                                MinWidth="140"/>
                        <Button Content="Ekle"
                                Style="{StaticResource SuccessBtn}"
                                Command="{Binding AddCommand}"
                                Margin="0,0,8,0"
                                MinWidth="90"/>
                        <Button Content="Güncelle"
                                Style="{StaticResource EditBtn}"
                                Command="{Binding EditCommand}"
                                Margin="0,0,8,0"
                                MinWidth="90"/>
                        <Button Content="Sil"
                                Style="{StaticResource DangerBtn}"
                                Command="{Binding DeleteCommand}"
                                Margin="0,0,8,0"
                                MinWidth="90"
                                Visibility="{Binding ShowActivateMode, Converter={StaticResource InvBoolToVis}}"/>
                        <Button Content="Aktif Et"
                                Style="{StaticResource SuccessBtn}"
                                Command="{Binding DeleteCommand}"
                                MinWidth="90"
                                Visibility="{Binding ShowActivateMode, Converter={StaticResource BoolToVis}}"/>
                    </WrapPanel>
                </StackPanel>

                <dxg:GridControl Grid.Row="1"
                                 x:Name="GridHareket"
                                 ItemsSource="{Binding Rows}"
                                 CurrentItem="{Binding SelectedRow, Mode=TwoWay}"
                                 AutoGenerateColumns="None"
                                 VerticalAlignment="Stretch">
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="Tarih" Header="Tarih" Width="160">
                            <dxg:GridColumn.EditSettings>
                                <dxe:DateEditSettings DisplayFormat="dd.MM.yyyy HH:mm:ss"
                                                      Mask="dd.MM.yyyy HH:mm:ss"
                                                      MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Firma" Header="Firma" Width="120"/>
                        <dxg:GridColumn FieldName="SicilNo" Header="Sicil No" Width="90"/>
                        <dxg:GridColumn FieldName="AdSoyad" Header="Adı Soyadı" Width="160"/>
                        <dxg:GridColumn FieldName="CihazAdi" Header="Turnike" Width="130"/>
                        <dxg:GridColumn FieldName="Tip" Header="Hareket Tipi" Width="110"/>
                        <dxg:GridColumn FieldName="KayitZamani" Header="Kayıt Zamanı" Width="160">
                            <dxg:GridColumn.EditSettings>
                                <dxe:DateEditSettings DisplayFormat="dd.MM.yyyy HH:mm:ss"
                                                      Mask="dd.MM.yyyy HH:mm:ss"
                                                      MaskUseAsDisplayFormat="True"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="AktifMi" Visible="False"/>
                        <dxg:GridColumn FieldName="Id" Visible="False"/>
                        <dxg:GridColumn FieldName="CihazId" Visible="False"/>
                        <dxg:GridColumn FieldName="PersonelId" Visible="False"/>
                        <dxg:GridColumn FieldName="FirmaId" Visible="False"/>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView Style="{StaticResource CeypassListTableView}">
                            <dxg:TableView.FormatConditions>
                                <dxg:FormatCondition Expression="Not [AktifMi]" ApplyToRow="True">
                                    <dxg:FormatCondition.Format>
                                        <dx:Format Background="#E6E6E6" Foreground="#0F172A"/>
                                    </dxg:FormatCondition.Format>
                                </dxg:FormatCondition>
                                <dxg:FormatCondition Expression="[AktifMi] And [Tip] = 'Giriş'" ApplyToRow="True">
                                    <dxg:FormatCondition.Format>
                                        <dx:Format Background="#BBDEFB" Foreground="#0F172A"/>
                                    </dxg:FormatCondition.Format>
                                </dxg:FormatCondition>
                                <dxg:FormatCondition Expression="[AktifMi] And [Tip] = 'Yemekhane'" ApplyToRow="True">
                                    <dxg:FormatCondition.Format>
                                        <dx:Format Background="#C8E6C9" Foreground="#0F172A"/>
                                    </dxg:FormatCondition.Format>
                                </dxg:FormatCondition>
                                <dxg:FormatCondition Expression="[AktifMi] And ([Tip] = 'Çıkış' Or [Tip] = 'Cikis')" ApplyToRow="True">
                                    <dxg:FormatCondition.Format>
                                        <dx:Format Background="#FFCDD2" Foreground="#0F172A"/>
                                    </dxg:FormatCondition.Format>
                                </dxg:FormatCondition>
                                <dxg:FormatCondition Expression="[AktifMi] And [Tip] &lt;&gt; 'Giriş' And [Tip] &lt;&gt; 'Yemekhane' And [Tip] &lt;&gt; 'Çıkış' And [Tip] &lt;&gt; 'Cikis'" ApplyToRow="True">
                                    <dxg:FormatCondition.Format>
                                        <dx:Format Background="#FFF9C4" Foreground="#0F172A"/>
                                    </dxg:FormatCondition.Format>
                                </dxg:FormatCondition>
                            </dxg:TableView.FormatConditions>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </Grid>
        </Border>
        </Grid>

        <controls:CeypassBusyOverlay IsBusy="{Binding Busy}"
                                     Title="Hareketler yükleniyor..."
                                     Message="Lütfen bekleyin"/>
    </Grid>
</UserControl>

