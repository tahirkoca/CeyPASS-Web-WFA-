<Window x:Class="CeyPASS.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:controls="clr-namespace:CeyPASS.WPF.Controls"
        xmlns:wpf="clr-namespace:CeyPASS.WPF"
        Title="{Binding WindowTitle}"
        Height="700" Width="460"
        MinHeight="700" MinWidth="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        MouseLeftButtonDown="Window_OnMouseLeftButtonDown"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="LoginFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1C1C1C"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="PrimaryLoginButton" TargetType="Button">
            <Setter Property="Background" Value="#C83232"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#B42828"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#0078D4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                   TextDecorations="Underline" HorizontalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Margin="16" CornerRadius="22" Background="#01000000">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.28" Color="#000000"/>
            </Border.Effect>
        </Border>

        <Border Margin="16" CornerRadius="22" BorderBrush="#40FFFFFF" BorderThickness="1">
            <Border.Background>
                <ImageBrush ImageSource="pack://application:,,,/Assets/ceyportTekirdag.png"
                            Stretch="UniformToFill"/>
            </Border.Background>
            <Grid>
                <Border CornerRadius="21" Background="#2A000000" IsHitTestVisible="False"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,18,18,0">
                    <controls:CeypassThemeToggle Margin="0,0,8,0"/>
                    <Button Padding="10,7"
                            Command="{Binding LiveMonitorCommand}"
                            Cursor="Hand" Background="#66FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="pack://application:,,,/Assets/icons8-security-check-48.png"
                                           Width="22" Height="22" Margin="0,0,8,0" Opacity="0.92"/>
                                    <TextBlock Text="Canlı İzleme Paneli" FontWeight="SemiBold"
                                               FontSize="12" VerticalAlignment="Center" Foreground="#1C1C1C"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#99FFFFFF"/>
                                    <Setter TargetName="b" Property="BorderBrush" Value="#88FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                </StackPanel>

                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="392" Background="#E6FFFFFF" CornerRadius="16"
                        BorderBrush="#88FFFFFF" BorderThickness="1" Padding="0,0,0,18">
                    <StackPanel>
                        <Border Padding="32,22,32,6">
                            <Image Source="pack://application:,,,/Assets/ceyLogo.png"
                                   Height="52" Stretch="Uniform" HorizontalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Hoş Geldiniz"
                                   FontFamily="Tahoma" FontSize="20" FontWeight="Bold"
                                   Foreground="#1C1C1C" HorizontalAlignment="Center"
                                   Margin="32,6,32,0"/>
                        <TextBlock Text="Devam etmek için giriş yapın"
                                   FontSize="13" Foreground="#6C757D"
                                   HorizontalAlignment="Center" Margin="32,4,32,12"/>

                        <StackPanel Margin="32,6,32,0">
                            <TextBlock Text="Kullanıcı Adı" Style="{StaticResource LoginFieldLabel}"/>
                            <dxe:ComboBoxEdit ItemsSource="{Binding Users}"
                                              EditValue="{Binding SelectedUser, UpdateSourceTrigger=PropertyChanged}"
                                              IsTextEditable="False"
                                              Height="36" Margin="0,0,0,14"
                                              NullText="Kullanıcı seçiniz"
                                              wpf:FieldValidation.Error="{Binding Errors[SelectedUser]}"/>

                            <TextBlock Text="Şifre" Style="{StaticResource LoginFieldLabel}"/>
                            <PasswordBox x:Name="PwdBox"
                                         Height="36" FontSize="14" Padding="8,6"
                                         Margin="0,0,0,4"
                                         PasswordChanged="PwdBox_OnPasswordChanged"
                                         wpf:FieldValidation.Error="{Binding Errors[Password]}">
                                <PasswordBox.Style>
                                    <Style TargetType="PasswordBox">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </PasswordBox.Style>
                            </PasswordBox>
                            <TextBox x:Name="PwdPlain"
                                     Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                     Height="36" FontSize="14" Padding="8,6"
                                     Margin="0,0,0,4"
                                     wpf:FieldValidation.Error="{Binding Errors[Password]}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <CheckBox Content="Şifreyi göster"
                                      IsChecked="{Binding ShowPassword}"
                                      Foreground="#6C757D" FontSize="12.5"
                                      Margin="0,6,0,4"/>

                            <TextBlock Text="{Binding Error}" Foreground="#C83232"
                                       TextWrapping="Wrap" Margin="0,0,0,6"
                                       FontSize="12.5"/>

                            <Button Content="GİRİŞ YAP"
                                    Style="{StaticResource PrimaryLoginButton}"
                                    Command="{Binding LoginCommand}"
                                    Margin="0,0,0,8"/>

                            <Button Content="Şifremi Unuttum"
                                    Style="{StaticResource LinkButton}"
                                    Command="{Binding ForgotPasswordCommand}"
                                    Margin="0,4,0,0" Height="28"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="20,0,0,16">
                    <StackPanel.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.45"/>
                    </StackPanel.Effect>
                    <TextBlock Text="Kapatmak için"
                               FontSize="12" Foreground="#F8FAFC"
                               VerticalAlignment="Center"/>
                    <Border Background="#66FFFFFF" CornerRadius="5"
                            Padding="7,2" Margin="7,0"
                            BorderBrush="#88FFFFFF" BorderThickness="1">
                        <TextBlock Text="Esc" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="#1C1C1C"/>
                    </Border>
                    <TextBlock Text="tuşuna basın"
                               FontSize="12" Foreground="#F8FAFC"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="{Binding VersionText}"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="0,0,20,16"
                           FontSize="13" FontWeight="SemiBold" Foreground="White">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.4"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
