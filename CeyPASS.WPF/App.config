<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- appsettings.Local.json SmtpSettings ile senkron (EmailService ConfigurationManager yolu) -->
    <add key="SmtpHost" value="smtp-mail.outlook.com" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpEnableSsl" value="true" />
    <add key="SmtpUsername" value="sistembildirim@ceyholding.com.tr" />
    <add key="SmtpPassword" value="YOUR_PASSWORD_HERE" />
    <add key="EmailFromAddress" value="sistembildirim@ceyholding.com.tr" />
    <add key="EmailFromName" value="CeyPASS Sistem" />
  </appSettings>
</configuration>