@model List<CeyPASS.Entities.Concrete.CihazListDTO>
@{
    ViewData["Title"] = "Cihazlar";
    var cihazTipleri = ViewBag.CihazTipleri as List<CeyPASS.Entities.Concrete.CihazTip> ?? new List<CeyPASS.Entities.Concrete.CihazTip>();
    var canCreate = ViewBag.CanCreate as bool? ?? false;
    var canUpdate = ViewBag.CanUpdate as bool? ?? false;
    var canDelete = ViewBag.CanDelete as bool? ?? false;
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <h2>Cihazlar</h2>
            
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
        </div>
    </div>

    @if (canCreate)
    {
        <div class="row mb-3">
            <div class="col-12">
                <a href="@Url.Action("Create")" class="btn btn-success" title="Yeni bir turnike veya geçiş kontrol cihazı tanımı ekle">
                    <i class="bi bi-plus-circle"></i> Yeni Cihaz Ekle
                </a>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Cihaz Listesi (@Model.Count kayıt)</h5>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover js-datatable">
                                <thead>
                                    <tr>
                                        <th>Cihaz Adı</th>
                                        <th>IP Adres</th>
                                        <th>Port</th>
                                        <th>Firma</th>
                                        <th>Durum</th>
                                        <th class="text-center">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cihaz in Model)
                                    {
                                        <tr class="@(!cihaz.AktifMi ? "table-secondary" : "")">
                                            <td>@cihaz.CihazAdi</td>
                                            <td>@cihaz.IPAdres</td>
                                            <td>@cihaz.Port</td>
                                            <td>@cihaz.FirmaAdi</td>
                                            <td>
                                                @if (cihaz.AktifMi)
                                                {
                                                    <span class="badge bg-success">Aktif</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Pasif</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="d-flex gap-1 justify-content-center">
                                                    @if (canUpdate)
                                                    {
                                                        <a href="@Url.Action("Edit", new { id = cihaz.CihazId })" class="btn btn-sm btn-warning" title="Düzenle">
                                                            <i class="bi bi-pencil"></i>
                                                        </a>
                                                    }
                                                    @if (canDelete && cihaz.AktifMi)
                                                    {
                                                        <form method="post" action="@Url.Action("Delete", new { id = cihaz.CihazId })" style="display: inline;">
                                                            @Html.AntiForgeryToken()
                                                            <button type="button" class="btn btn-sm btn-danger btn-sil-onay" data-msg="Bu cihazı pasif yapmak istediğinizden emin misiniz?" data-btn-text="Pasif Yap" title="Pasif Yap">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                    @if (canUpdate && !cihaz.AktifMi)
                                                    {
                                                        <form method="post" action="@Url.Action("AktifYap", new { id = cihaz.CihazId })" style="display: inline;">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-success" title="Aktif Yap">
                                                                <i class="bi bi-check-circle"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                    <button type="button" class="btn btn-sm btn-info text-white btn-qr-modal" data-id="@cihaz.CihazId" data-isim="@cihaz.CihazAdi" title="QR Kod Üret">
                                                        <i class="bi bi-qr-code"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> Kayıt bulunamadı.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="silOnayModal" tabindex="-1" aria-labelledby="silOnayModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="silOnayModalLabel"><i class="bi bi-exclamation-triangle me-2"></i>Onay</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body" id="silOnayModalBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-danger" id="silOnayModalSilBtn"><i class="bi bi-trash me-1"></i>Pasif Yap</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="qrModal" tabindex="-1" aria-labelledby="qrModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title w-100" id="qrModalLabel">Turnike QR Kodu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body pt-2 pb-4 px-4">
                <p class="text-muted small mb-3" id="qrCihazIsim"></p>
                <div class="d-inline-block border rounded shadow-sm p-2" style="background:#fff;" id="qrImgContainer">
                    <img id="qrImg" src="" alt="QR Kod" style="width:256px; height:256px; display:block;" />
                </div>
                <div id="qrError" class="alert alert-danger d-none mt-3 text-start" role="alert">
                    <div class="d-flex align-items-center mb-2">
                        <i class="bi bi-geo-alt-fill fs-4 me-2"></i>
                        <strong class="fs-5">QR Üretilemedi!</strong>
                    </div>
                    <p class="mb-0">
                        Bu cihaz için <strong>Enlem ve Boylam (Konum)</strong> verisi tanımlanmamış. Güvenlik kuralları gereği, personelin işlem esnasında cihaza yakın olduğunu konum bazlı doğrulayabilmemiz için cihaz konumunun girilmesi zorunludur.
                    </p>
                </div>
                <div class="mt-4" id="qrYazdirContainer">
                    <button type="button" class="btn btn-outline-primary w-100" id="qrYazdirBtn">
                        <i class="bi bi-printer me-1"></i> Yazdır / PDF Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script src="~/js/cihaz-index.js"></script>
}
