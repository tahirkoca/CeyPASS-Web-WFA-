@model System.Data.DataTable
@{
    ViewData["Title"] = "Raporlar";
    var raporlar = ViewBag.Raporlar as List<CeyPASS.Entities.Concrete.RaporTanimi> ?? new List<CeyPASS.Entities.Concrete.RaporTanimi>();
    var selectedProcedureAdi = ViewBag.SelectedProcedureAdi as string;
    var baslangicTarih = ViewBag.BaslangicTarih as DateTime? ?? new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    var bitisTarih = ViewBag.BitisTarih as DateTime? ?? DateTime.Today;
    var selectedFirmaId = ViewBag.SelectedFirmaId as int? ?? 0;
    var firmalar = ViewBag.Firmalar as List<CeyPASS.Entities.Concrete.LookupItem> ?? new List<CeyPASS.Entities.Concrete.LookupItem>();
    var canExport = ViewBag.CanExport as bool? ?? false;
    var selectedRapor = ViewBag.SelectedRapor as CeyPASS.Entities.Concrete.RaporTanimi;
    var currentPage = ViewBag.Page as int? ?? 1;
    var pageSize = ViewBag.PageSize as int? ?? 100;
    var totalCount = ViewBag.TotalCount as int? ?? (Model?.Rows?.Count ?? 0);
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var startIndex = totalCount == 0 ? 0 : ((currentPage - 1) * pageSize + 1);
    var endIndex = totalCount == 0 ? 0 : Math.Min(currentPage * pageSize, totalCount);
    var isyeriIdsParam = ViewBag.IsyeriIdsParam as string ?? "";
    var selectedIsyeriIds = ViewBag.SelectedIsyeriIds as List<int> ?? new List<int>();
    var isyerleri = ViewBag.Isyerleri as List<CeyPASS.Entities.Concrete.LookupItem> ?? new List<CeyPASS.Entities.Concrete.LookupItem>();
    var cihazIdsParam = ViewBag.CihazIdsParam as string ?? "";
    var selectedCihazIds = ViewBag.SelectedCihazIds as List<int> ?? new List<int>();
    var cihazlar = ViewBag.Cihazlar as List<CeyPASS.Entities.Concrete.CihazListDTO> ?? new List<CeyPASS.Entities.Concrete.CihazListDTO>();
    var multiKind = ViewBag.MultiSelectKind as CeyPASS.Infrastructure.Helpers.RaporParametreHelper.MultiSelectKind?
                    ?? CeyPASS.Infrastructure.Helpers.RaporParametreHelper.MultiSelectKind.None;
}
<style>
    .rapor-table-wrapper {
        max-height: 560px;
        overflow: auto;
        border: 1px solid rgba(0, 0, 0, .08);
        border-radius: .375rem;
        background: #fff;
    }
    .rapor-table {
        margin-bottom: 0;
        width: 100%;
    }
    .rapor-table thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background: var(--bs-tertiary-bg);
        color: var(--bs-body-color);
        font-weight: 600;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        padding: 0.75rem;
        border-bottom: 2px solid rgba(0, 0, 0, .08);
    }
    .rapor-table tbody td {
        padding: 0.6rem 0.75rem;
        vertical-align: middle;
    }
    .rapor-table tbody tr:hover {
        background-color: rgba(0, 0, 0, .02);
    }
    /* Toast - sağ üst, 5 sn */
    .rapor-toast-container {
        position: fixed;
        top: 1rem;
        right: 1rem;
        z-index: 9999;
        max-width: 360px;
    }
    .rapor-toast {
        padding: 0.75rem 1rem;
        border-radius: 0.375rem;
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15);
        margin-bottom: 0.5rem;
        animation: rapor-toast-in 0.3s ease;
    }
    .rapor-toast.success { background: #d1e7dd; color: #0f5132; }
    .rapor-toast.danger { background: #f8d7da; color: #842029; }
    .rapor-toast.info { background: #cff4fc; color: #055160; }
    @@keyframes rapor-toast-in { from { opacity: 0; transform: translateX(100%); } to { opacity: 1; transform: translateX(0); } }
</style>
<div class="container-fluid">
    <div id="raporToastContainer" class="rapor-toast-container" aria-live="polite"></div>
    <div class="row mb-3">
        <div class="col-12">
            <h2>Raporlar</h2>
            
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
        </div>
    </div>

    <!-- Rapor Seçimi ve Filtreler -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Rapor Seçimi ve Parametreler</h5>
                </div>
                <div class="card-body">
                    <form method="get" action="@Url.Action("Index")" id="raporForm">
                        <input type="hidden" name="page" value="1" />
                        <div class="row g-3 align-items-end">
                            <div class="col-12 col-lg-2">
                                <label for="firmaId" class="form-label">Firma <span class="text-danger">*</span></label>
                                <select name="firmaId" id="firmaId" class="form-select" required title="Rapor firması">
                                    @foreach (var f in firmalar)
                                    {
                                        if (f.Id == selectedFirmaId)
                                        {
                                            <option value="@f.Id" selected="selected">@f.Ad</option>
                                        }
                                        else
                                        {
                                            <option value="@f.Id">@f.Ad</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-12 col-lg-5">
                                <label for="procedureAdi" class="form-label">Rapor Türü <span class="text-danger">*</span></label>
                                <select name="procedureAdi" id="procedureAdi" class="form-select" required title="Dosya tipine göre rapor seçimi yapın">
                                    <option value="">-- Rapor Seçiniz --</option>
                                    @foreach (var rapor in raporlar.Where(r => r.AktifMi))
                                    {
                                        if (rapor.ProcedureAdi == selectedProcedureAdi)
                                        {
                                            <option value="@rapor.ProcedureAdi" selected="selected">
                                                @rapor.RaporAdi
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@rapor.ProcedureAdi">
                                                @rapor.RaporAdi
                                            </option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-12 col-lg-2">
                                <label for="tarihBaslangic" class="form-label">Başlangıç Tarihi <span class="text-danger">*</span></label>
                                <input type="date" name="tarihBaslangic" id="tarihBaslangic" class="form-control" required 
                                       value="@baslangicTarih.ToString("yyyy-MM-dd")" title="Rapor başlangıç tarihi" />
                            </div>

                            <div class="col-12 col-lg-2">
                                <label for="tarihBitis" class="form-label">Bitiş Tarihi <span class="text-danger">*</span></label>
                                <input type="date" name="tarihBitis" id="tarihBitis" class="form-control" required 
                                       value="@bitisTarih.ToString("yyyy-MM-dd")" title="Rapor bitiş tarihi" />
                            </div>

                            <div class="col-12 col-lg-2">
                                <label for="pageSize" class="form-label">Sayfa başına:</label>
                                <select name="pageSize" id="pageSize" class="form-select" title="Sayfa başına gösterilecek kayıt sayısı">
                                    @if (pageSize == 50)
                                    {
                                        <option value="50" selected="selected">50</option>
                                        <option value="100">100</option>
                                        <option value="200">200</option>
                                        <option value="500">500</option>
                                    }
                                    else if (pageSize == 200)
                                    {
                                        <option value="50">50</option>
                                        <option value="100">100</option>
                                        <option value="200" selected="selected">200</option>
                                        <option value="500">500</option>
                                    }
                                    else if (pageSize == 500)
                                    {
                                        <option value="50">50</option>
                                        <option value="100">100</option>
                                        <option value="200">200</option>
                                        <option value="500" selected="selected">500</option>
                                    }
                                    else
                                    {
                                        <option value="50">50</option>
                                        <option value="100" selected="selected">100</option>
                                        <option value="200">200</option>
                                        <option value="500">500</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-lg-2">
                                <button type="submit" class="btn btn-primary w-100" title="Seçili parametrelere göre raporu oluştur">
                                    <i class="bi bi-search"></i> Rapor Getir
                                </button>
                            </div>

                            @if (multiKind == CeyPASS.Infrastructure.Helpers.RaporParametreHelper.MultiSelectKind.Isyeri && isyerleri.Count > 0)
                            {
                                <div class="col-12">
                                    <label class="form-label">İşyerleri <small class="text-muted">(hiç seçilmezse yetkili tüm işyerleri)</small></label>
                                    <div class="d-flex flex-wrap gap-3 border rounded p-2 bg-light">
                                        @foreach (var iy in isyerleri.Where(i => i.Id > 0))
                                        {
                                            var checkedAttr = selectedIsyeriIds.Contains(iy.Id) ? "checked" : "";
                                            <div class="form-check">
                                                <input class="form-check-input multi-chk" type="checkbox" value="@iy.Id" id="isyeri_@iy.Id" @checkedAttr />
                                                <label class="form-check-label" for="isyeri_@iy.Id">@iy.Ad</label>
                                            </div>
                                        }
                                    </div>
                                    <input type="hidden" name="isyeriIds" id="isyeriIdsHidden" value="@isyeriIdsParam" />
                                </div>
                            }
                            else if (multiKind == CeyPASS.Infrastructure.Helpers.RaporParametreHelper.MultiSelectKind.Cihaz && cihazlar.Count > 0)
                            {
                                <div class="col-12">
                                    <label class="form-label">Cihazlar <small class="text-muted">(hiç seçilmezse firmanın tüm aktif cihazları)</small></label>
                                    <div class="d-flex flex-wrap gap-3 border rounded p-2 bg-light">
                                        @foreach (var c in cihazlar)
                                        {
                                            var checkedAttr = selectedCihazIds.Contains(c.CihazId) ? "checked" : "";
                                            <div class="form-check">
                                                <input class="form-check-input multi-chk" type="checkbox" value="@c.CihazId" id="cihaz_@c.CihazId" @checkedAttr />
                                                <label class="form-check-label" for="cihaz_@c.CihazId">@c.CihazAdi</label>
                                            </div>
                                        }
                                    </div>
                                    <input type="hidden" name="cihazIds" id="cihazIdsHidden" value="@cihazIdsParam" />
                                </div>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Rapor Verisi -->
    @if (Model != null && Model.Rows.Count > 0)
    {
        <div class="row mb-3">
            <div class="col-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0">
                                @(selectedRapor?.RaporAdi ?? "Rapor") 
                                <small class="text-muted">(Toplam @totalCount kayıt)</small>
                            </h5>
                            @if (totalCount > 0)
                            {
                                <small class="text-muted">Sayfa @currentPage / @totalPages • @startIndex - @endIndex arası gösteriliyor</small>
                            }
                        </div>
                        @if (canExport)
                        {
                            <div>
                                <button type="button" class="btn btn-sm btn-success" onclick="exportExcel()" title="Mevcut raporu Excel dosyası olarak indir">
                                    <i class="bi bi-file-earmark-excel"></i> Excel'e Aktar
                                </button>
                                <button type="button" class="btn btn-sm btn-danger" onclick="exportPdf()" title="Mevcut raporu PDF dosyası olarak indir">
                                    <i class="bi bi-file-earmark-pdf"></i> PDF'e Aktar
                                </button>
                            </div>
                        }
                    </div>
                    <div class="card-body">
                        <div class="mb-3 d-flex gap-2 flex-wrap">
                            <input type="text" id="filterInput" class="form-control flex-grow-1" style="max-width: 320px;" placeholder="Raporlarda arama yapabilirsiniz..." title="Rapor sonuçları içinde anlık arama yapın" />
                        </div>
                        <div class="rapor-table-wrapper">
                            <table class="table table-hover table-bordered rapor-table" id="raporTable">
                                <thead>
                                    <tr>
                                        @foreach (System.Data.DataColumn column in Model.Columns)
                                        {
                                            <th>@column.ColumnName</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (System.Data.DataRow row in Model.Rows)
                                    {
                                        <tr>
                                            @foreach (var item in row.ItemArray)
                                            {
                                                <td>@(item?.ToString() ?? "-")</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (totalPages > 1)
                        {
                            <nav aria-label="Rapor sayfalama" class="mt-3">
                                <ul class="pagination justify-content-center flex-wrap mb-0">
                                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { procedureAdi = selectedProcedureAdi, tarihBaslangic = baslangicTarih, tarihBitis = bitisTarih, firmaId = selectedFirmaId, isyeriIds = isyeriIdsParam, cihazIds = cihazIdsParam, page = currentPage - 1, pageSize })" aria-label="Önceki">
                                            <span aria-hidden="true">&laquo;</span>
                                        </a>
                                    </li>

                                    @{
                                        var window = 2;
                                        var start = Math.Max(1, currentPage - window);
                                        var end = Math.Min(totalPages, currentPage + window);
                                        if (start > 1)
                                        {
                                            <li class="page-item">
                                                <a class="page-link" href="@Url.Action("Index", new { procedureAdi = selectedProcedureAdi, tarihBaslangic = baslangicTarih, tarihBitis = bitisTarih, firmaId = selectedFirmaId, isyeriIds = isyeriIdsParam, cihazIds = cihazIdsParam, page = 1, pageSize })">1</a>
                                            </li>
                                            if (start > 2)
                                            {
                                                <li class="page-item disabled"><span class="page-link">…</span></li>
                                            }
                                        }

                                        for (var p = start; p <= end; p++)
                                        {
                                            <li class="page-item @(p == currentPage ? "active" : "")">
                                                <a class="page-link" href="@Url.Action("Index", new { procedureAdi = selectedProcedureAdi, tarihBaslangic = baslangicTarih, tarihBitis = bitisTarih, firmaId = selectedFirmaId, isyeriIds = isyeriIdsParam, cihazIds = cihazIdsParam, page = p, pageSize })">@p</a>
                                            </li>
                                        }

                                        if (end < totalPages)
                                        {
                                            if (end < totalPages - 1)
                                            {
                                                <li class="page-item disabled"><span class="page-link">…</span></li>
                                            }
                                            <li class="page-item">
                                                <a class="page-link" href="@Url.Action("Index", new { procedureAdi = selectedProcedureAdi, tarihBaslangic = baslangicTarih, tarihBitis = bitisTarih, firmaId = selectedFirmaId, isyeriIds = isyeriIdsParam, cihazIds = cihazIdsParam, page = totalPages, pageSize })">@totalPages</a>
                                            </li>
                                        }
                                    }

                                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { procedureAdi = selectedProcedureAdi, tarihBaslangic = baslangicTarih, tarihBitis = bitisTarih, firmaId = selectedFirmaId, isyeriIds = isyeriIdsParam, cihazIds = cihazIdsParam, page = currentPage + 1, pageSize })" aria-label="Sonraki">
                                            <span aria-hidden="true">&raquo;</span>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(selectedProcedureAdi))
    {
        <div class="row">
            <div class="col-12">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> Seçilen kriterlere uygun veri bulunamadı.
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="alert alert-secondary">
                    <i class="bi bi-info-circle"></i> Lütfen bir rapor seçin ve tarih aralığı belirleyin.
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <script>
        if (window.CeyPASS && CeyPASS.filters) {
            CeyPASS.filters.bindForm('rapor', '#raporForm', [
                'firmaId', 'procedureAdi', 'tarihBaslangic', 'tarihBitis', 'pageSize', 'isyeriIds', 'cihazIds'
            ], { autoSubmit: false });
        }

        function syncMultiChkFromHidden() {
            var isyeriHidden = document.getElementById('isyeriIdsHidden');
            var cihazHidden = document.getElementById('cihazIdsHidden');
            var raw = (isyeriHidden && isyeriHidden.value) || (cihazHidden && cihazHidden.value) || '';
            if (!raw) return;
            var set = raw.split(',').map(function (s) { return s.trim(); }).filter(Boolean);
            document.querySelectorAll('.multi-chk').forEach(function (c) {
                c.checked = set.indexOf(String(c.value)) >= 0;
            });
        }
        syncMultiChkFromHidden();

        function syncMultiIdsHidden() {
            var isyeriHidden = document.getElementById('isyeriIdsHidden');
            var cihazHidden = document.getElementById('cihazIdsHidden');
            var ids = Array.from(document.querySelectorAll('.multi-chk:checked')).map(function (c) { return c.value; });
            var joined = ids.join(',');
            if (isyeriHidden) isyeriHidden.value = joined;
            if (cihazHidden) cihazHidden.value = joined;
        }

        document.getElementById('pageSize')?.addEventListener('change', function () {
            syncMultiIdsHidden();
            this.closest('form')?.submit();
        });

        document.getElementById('procedureAdi')?.addEventListener('change', function () {
            var form = this.closest('form');
            if (!form) return;
            var isyeri = document.getElementById('isyeriIdsHidden');
            var cihaz = document.getElementById('cihazIdsHidden');
            if (isyeri) isyeri.value = '';
            if (cihaz) cihaz.value = '';
            form.submit();
        });

        document.getElementById('raporForm')?.addEventListener('submit', function () {
            syncMultiIdsHidden();
        });

        function showToast(message, type) {
            type = type || 'success';
            var $c = $('#raporToastContainer');
            var $t = $('<div class="rapor-toast ' + type + '">' + message + '</div>');
            $c.append($t);
            setTimeout(function() { $t.fadeOut(300, function() { $(this).remove(); }); }, 5000);
        }

        function readBlobAsJson(blob, callback) {
            var reader = new FileReader();
            reader.onload = function() {
                try {
                    var o = JSON.parse(reader.result);
                    callback(o);
                } catch (e) {
                    callback({ message: 'Sunucu yanıtı okunamadı.' });
                }
            };
            reader.readAsText(blob);
        }

        // Tablo filtreleme
        $('#filterInput').on('keyup', function() {
            var value = $(this).val().toLowerCase();
            $('#raporTable tbody tr').filter(function() {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
            });
        });

        // Excel export
        function exportExcel() {
            $.ajax({
                url: '@Url.Action("ExportExcel")',
                method: 'POST',
                xhrFields: {
                    responseType: 'blob'
                },
                success: function(data) {
                    var blob = new Blob([data], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
                    var link = document.createElement('a');
                    link.href = window.URL.createObjectURL(blob);
                    link.download = '@(selectedRapor?.RaporAdi ?? "Rapor")_' + new Date().toISOString().slice(0,10).replace(/-/g,"") + '.xlsx';
                    link.click();
                    showToast('Excel dosyası indirildi.', 'success');
                },
                error: function(xhr) {
                    var errorMsg = 'Excel export sırasında bir hata oluştu.';
                    if (xhr.responseType === 'blob' && xhr.response instanceof Blob) {
                        readBlobAsJson(xhr.response, function(o) { showToast(o.message || errorMsg, 'danger'); });
                    } else if (xhr.responseJSON && xhr.responseJSON.message) {
                        showToast(xhr.responseJSON.message, 'danger');
                    } else {
                        showToast(errorMsg, 'danger');
                    }
                }
            });
        }

        // PDF export
        function exportPdf() {
            $.ajax({
                url: '@Url.Action("ExportPdf")',
                method: 'POST',
                xhrFields: {
                    responseType: 'blob'
                },
                success: function(data) {
                    var blob = new Blob([data], { type: 'application/pdf' });
                    var link = document.createElement('a');
                    link.href = window.URL.createObjectURL(blob);
                    link.download = '@(selectedRapor?.RaporAdi ?? "Rapor")_' + new Date().toISOString().slice(0,10).replace(/-/g,"") + '.pdf';
                    link.click();
                    showToast('PDF dosyası indirildi.', 'success');
                },
                error: function(xhr) {
                    var errorMsg = 'PDF export sırasında bir hata oluştu.';
                    if (xhr.responseType === 'blob' && xhr.response instanceof Blob) {
                        readBlobAsJson(xhr.response, function(o) { showToast(o.message || errorMsg, 'danger'); });
                    } else if (xhr.responseJSON && xhr.responseJSON.message) {
                        showToast(xhr.responseJSON.message, 'danger');
                    } else {
                        showToast(errorMsg, 'danger');
                    }
                }
            });
        }
    </script>
}
