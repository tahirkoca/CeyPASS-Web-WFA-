@{
    ViewData["Title"] = "Şifre Değiştir";
    var success = TempData["PasswordSuccess"] as string;
    var error = ViewBag.Error as string;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class="bi bi-key-fill text-primary me-2"></i>Şifre Değiştir
                    </h5>
                    <p class="text-muted small mb-0 mt-1">Güvenliğiniz için şifrenizi düzenli olarak değiştirmenizi öneririz.</p>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(success))
                    {
                        <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
                            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                            <div>@success</div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(error))
                    {
                        <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                            <div>@error</div>
                        </div>
                    }

                    <form asp-action="ChangePassword" method="post" autocomplete="off">
                        @Html.AntiForgeryToken()
                        
                        <div class="mb-3">
                            <label class="form-label fw-medium small text-uppercase text-muted">Mevcut Şifre</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-shield-lock"></i></span>
                                <input type="password" name="mevcutSifre" class="form-control border-start-0 ps-0" required placeholder="Gezinme şifreniz" />
                            </div>
                        </div>

                        <hr class="my-4 text-muted opacity-25" />

                        <div class="mb-3">
                            <label class="form-label fw-medium small text-uppercase text-muted">Yeni Şifre</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-key"></i></span>
                                <input type="password" name="yeniSifre" class="form-control border-start-0 ps-0" required placeholder="En az 6 karakter" minlength="6" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-medium small text-uppercase text-muted">Yeni Şifre (Tekrar)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-key-fill"></i></span>
                                <input type="password" name="yeniSifreTekrar" class="form-control border-start-0 ps-0" required placeholder="Yeni şifreyi onaylayın" minlength="6" />
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary py-2 fw-bold">
                                Şifreyi Güncelle
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4">
                <a href="javascript:history.back()" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i>Geri Dön
                </a>
            </div>
        </div>
    </div>
</div>
