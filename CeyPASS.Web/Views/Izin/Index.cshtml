@model List<CeyPASS.Entities.Concrete.KisiIzinListRow>
@{
    ViewData["Title"] = "İzinler";
    var kisiler = ViewBag.Kisiler as List<CeyPASS.Entities.Concrete.KisiListItem> ?? new List<CeyPASS.Entities.Concrete.KisiListItem>();
    var izinTipleri = ViewBag.IzinTipleri as List<CeyPASS.Entities.Concrete.IzinTip> ?? new List<CeyPASS.Entities.Concrete.IzinTip>();
    var selectedPersonelId = ViewBag.SelectedPersonelId as string;
    var selectedIzinTipId = ViewBag.SelectedIzinTipId as int?;
    var baslangicTarih = ViewBag.BaslangicTarih as DateTime? ?? new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    var bitisTarih = ViewBag.BitisTarih as DateTime? ?? new DateTime(DateTime.Today.Year, DateTime.Today.Month, DateTime.DaysInMonth(DateTime.Today.Year, DateTime.Today.Month));
    var canCreate = ViewBag.CanCreate as bool? ?? false;
    var canUpdate = ViewBag.CanUpdate as bool? ?? false;
    var canDelete = ViewBag.CanDelete as bool? ?? false;
    var currentPage = ViewBag.Page as int? ?? 1;
    var pageSize = ViewBag.PageSize as int? ?? 50;
    var totalCount = ViewBag.TotalCount as int? ?? Model.Count;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var startIndex = totalCount == 0 ? 0 : ((currentPage - 1) * pageSize + 1);
    var endIndex = totalCount == 0 ? 0 : Math.Min(currentPage * pageSize, totalCount);
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <h2>İzinler</h2>
            
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
        </div>
    </div>

    <!-- Filtreler -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Filtreler</h5>
                </div>
                <div class="card-body">
                    <form method="get" action="@Url.Action("Index")" id="filterForm">
                        <input type="hidden" name="page" value="1" />
                        <div class="d-flex flex-wrap flex-xl-nowrap gap-3 align-items-end">
                            <div style="flex: 3 1 200px; min-width: 150px;">
                                <label for="personelId" class="form-label">Personel:</label>
                                <select name="personelId" id="personelId" class="form-select">
                                    <option value="ALL">-- TÜMÜ --</option>
                                    @foreach (var kisi in kisiler)
                                    {
                                        if (kisi.PersonelId == selectedPersonelId)
                                        {
                                            <option value="@kisi.PersonelId" selected="selected">@kisi.AdSoyad</option>
                                        }
                                        else
                                        {
                                            <option value="@kisi.PersonelId">@kisi.AdSoyad</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div style="flex: 2 1 140px; min-width: 120px;">
                                <label for="izinTipId" class="form-label">İzin Tipi:</label>
                                <select name="izinTipId" id="izinTipId" class="form-select">
                                    <option value="0">-- TÜMÜ --</option>
                                    @foreach (var tip in izinTipleri)
                                    {
                                        if (tip.IzinTipId == selectedIzinTipId)
                                        {
                                            <option value="@tip.IzinTipId" selected="selected">@tip.Ad</option>
                                        }
                                        else
                                        {
                                            <option value="@tip.IzinTipId">@tip.Ad</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div style="flex: 1 1 130px; min-width: 120px;">
                                <label for="baslangic" class="form-label">Başlangıç:</label>
                                <input type="date" name="baslangic" id="baslangic" class="form-control"
                                       value="@baslangicTarih.ToString("yyyy-MM-dd")" />
                            </div>

                            <div style="flex: 1 1 130px; min-width: 120px;">
                                <label for="bitis" class="form-label">Bitiş:</label>
                                <input type="date" name="bitis" id="bitis" class="form-control"
                                       value="@bitisTarih.ToString("yyyy-MM-dd")" />
                            </div>

                            <div style="flex: 0 0 auto;">
                                <div class="d-flex gap-2 flex-nowrap">
                                    <button type="submit" class="btn btn-primary text-nowrap">
                                        <i class="bi bi-search"></i> Ara
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn btn-secondary text-nowrap">
                                        <i class="bi bi-x-circle"></i> Temizle
                                    </a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- İzinler Tablosu -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0">İzinler (Toplam @totalCount kayıt)</h5>
                        @if (totalCount > 0)
                        {
                            <small class="text-muted">Sayfa @currentPage / @totalPages • @startIndex - @endIndex arası gösteriliyor</small>
                        }
                    </div>
                    <div class="d-flex align-items-end gap-2 flex-wrap justify-content-end">
                        <form method="get" action="@Url.Action("Index")" class="d-flex align-items-end gap-2 flex-wrap">
                            <input type="hidden" name="page" value="1" />
                            <input type="hidden" name="personelId" value="@(selectedPersonelId ?? "ALL")" />
                            <input type="hidden" name="izinTipId" value="@(selectedIzinTipId ?? 0)" />
                            <input type="hidden" name="baslangic" value="@baslangicTarih.ToString("yyyy-MM-dd")" />
                            <input type="hidden" name="bitis" value="@bitisTarih.ToString("yyyy-MM-dd")" />
                            <div style="min-width: 90px; max-width: 110px;">
                                <label for="pageSize" class="form-label text-nowrap mb-0">Sayfa başına:</label>
                                <select name="pageSize" id="pageSize" class="form-select" style="width: 5rem;">
                                    @if (pageSize == 20)
                                    {
                                        <option value="20" selected="selected">20</option>
                                        <option value="50">50</option>
                                        <option value="100">100</option>
                                        <option value="200">200</option>
                                    }
                                    else if (pageSize == 100)
                                    {
                                        <option value="20">20</option>
                                        <option value="50">50</option>
                                        <option value="100" selected="selected">100</option>
                                        <option value="200">200</option>
                                    }
                                    else if (pageSize == 200)
                                    {
                                        <option value="20">20</option>
                                        <option value="50">50</option>
                                        <option value="100">100</option>
                                        <option value="200" selected="selected">200</option>
                                    }
                                    else
                                    {
                                        <option value="20">20</option>
                                        <option value="50" selected="selected">50</option>
                                        <option value="100">100</option>
                                        <option value="200">200</option>
                                    }
                                </select>
                            </div>
                        </form>

                        @if (canCreate)
                        {
                            <a href="@Url.Action("Create")" class="btn btn-success">
                                <i class="bi bi-plus-circle"></i> Yeni İzin Ekle
                            </a>
                        }
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Sicil No</th>
                                        <th>Adı Soyadı</th>
                                        <th>Firma Adı</th>
                                        <th>İzin Tipi</th>
                                        <th>Başlangıç Tarihi</th>
                                        <th>Bitiş Tarihi</th>
                                        <th>Süre (Gün)</th>
                                        <th>Süre (Saat)</th>
                                        <th>Saatlik İzin Mi</th>
                                        <th>Açıklama</th>
                                        <th>İşlenme Tarihi</th>
                                        <th>İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var izin in Model)
                                    {
                                        <tr>
                                            <td>@(izin.SicilNo ?? "-")</td>
                                            <td>@(izin.AdSoyad ?? "-")</td>
                                            <td>@(izin.FirmaAdi ?? "-")</td>
                                            <td>@(izin.IzinTipi ?? "-")</td>
                                            <td>@izin.IzinBaslangic.ToString("dd.MM.yyyy")</td>
                                            <td>@izin.IzinBitis.ToString("dd.MM.yyyy")</td>
                                            <td>@(izin.SureGun ?? "-")</td>
                                            <td>@izin.SureSaat.ToString("F2")</td>
                                            <td>
                                                @if (izin.SaatlikIzin == "Evet")
                                                {
                                                    <span class="badge bg-info">Evet</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Hayır</span>
                                                }
                                            </td>
                                            <td>@(izin.Aciklama ?? "-")</td>
                                            <td>@(izin.IslenmeTarihi?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                                            <td>
                                                @if (canUpdate)
                                                {
                                                    <a href="@Url.Action("Edit", new { id = izin.KisiIzinId })" class="btn btn-sm btn-warning me-1" title="Güncelle">
                                                        <i class="bi bi-pencil"></i> Güncelle
                                                    </a>
                                                }
                                                @if (canDelete)
                                                {
                                                    <button type="button" class="btn btn-sm btn-danger btn-izin-sil" title="Sil"
                                                            data-bs-toggle="modal" data-bs-target="#izinSilModal"
                                                            data-izin-id="@izin.KisiIzinId"
                                                            data-izin-info="@(izin.AdSoyad ?? "") - @(izin.IzinTipi ?? "") (@izin.IzinBaslangic.ToString("dd.MM.yyyy"))">
                                                        <i class="bi bi-trash"></i> Sil
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> Seçilen kriterlere uygun izin bulunamadı.
                        </div>
                    }

                    @if (totalPages > 1)
                    {
                        <nav aria-label="İzin sayfalama" class="mt-3">
                            <ul class="pagination justify-content-center flex-wrap mb-0">
                                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { personelId = selectedPersonelId, izinTipId = selectedIzinTipId, baslangic = baslangicTarih, bitis = bitisTarih, page = currentPage - 1, pageSize })" aria-label="Önceki">
                                        <span aria-hidden="true">&laquo;</span>
                                    </a>
                                </li>

                                @{
                                    var window = 2;
                                    var start = Math.Max(1, currentPage - window);
                                    var end = Math.Min(totalPages, currentPage + window);
                                    if (start > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("Index", new { personelId = selectedPersonelId, izinTipId = selectedIzinTipId, baslangic = baslangicTarih, bitis = bitisTarih, page = 1, pageSize })">1</a>
                                        </li>
                                        if (start > 2)
                                        {
                                            <li class="page-item disabled"><span class="page-link">…</span></li>
                                        }
                                    }

                                    for (var p = start; p <= end; p++)
                                    {
                                        <li class="page-item @(p == currentPage ? "active" : "")">
                                            <a class="page-link" href="@Url.Action("Index", new { personelId = selectedPersonelId, izinTipId = selectedIzinTipId, baslangic = baslangicTarih, bitis = bitisTarih, page = p, pageSize })">@p</a>
                                        </li>
                                    }

                                    if (end < totalPages)
                                    {
                                        if (end < totalPages - 1)
                                        {
                                            <li class="page-item disabled"><span class="page-link">…</span></li>
                                        }
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("Index", new { personelId = selectedPersonelId, izinTipId = selectedIzinTipId, baslangic = baslangicTarih, bitis = bitisTarih, page = totalPages, pageSize })">@totalPages</a>
                                        </li>
                                    }
                                }

                                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { personelId = selectedPersonelId, izinTipId = selectedIzinTipId, baslangic = baslangicTarih, bitis = bitisTarih, page = currentPage + 1, pageSize })" aria-label="Sonraki">
                                        <span aria-hidden="true">&raquo;</span>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (canDelete)
    {
        <div class="modal fade" id="izinSilModal" tabindex="-1" aria-labelledby="izinSilModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title d-flex align-items-center gap-2" id="izinSilModalLabel">
                            <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                            Onay
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                    </div>
                    <form id="izinSilForm" method="post" action="@Url.Action("Delete")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" id="izinSilIzinId" />
                        <div class="modal-body pt-0">
                            <p class="mb-0">Seçili izin silinsin mi?</p>
                            <p class="small text-muted mt-2 mb-0" id="izinSilInfo"></p>
                        </div>
                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <i class="bi bi-x-lg me-1"></i>İptal
                            </button>
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash me-1"></i>Tamam
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script>
        document.getElementById('pageSize')?.addEventListener('change', function () {
            // pageSize artık tablo başlığındaki formda; değişince filtreleri koruyarak yeniden yükle
            this.closest('form')?.submit();
        });
    </script>
    @if (canDelete)
    {
        <script>
            (function () {
                var modal = document.getElementById('izinSilModal');
                var form = document.getElementById('izinSilForm');
                var idEl = document.getElementById('izinSilIzinId');
                var infoEl = document.getElementById('izinSilInfo');
                if (!modal || !form || !idEl) return;
                modal.addEventListener('shown.bs.modal', function (e) {
                    var btn = e.relatedTarget;
                    if (!btn) return;
                    var id = btn.getAttribute('data-izin-id');
                    var info = btn.getAttribute('data-izin-info') || '';
                    idEl.value = id || '';
                    if (infoEl) infoEl.textContent = info ? 'İzin: ' + info : '';
                });
            })();
        </script>
    }
}
