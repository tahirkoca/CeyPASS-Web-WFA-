@{
    ViewData["Title"] = "Canlı İzleme";
    var user = ViewBag.User as CeyPASS.Entities.Concrete.AuthUserDTO;
    /* CanMisafirKart: kart atama/komut paneli; ShowHareketListesi: alt hareket tablosu (kapalıysa sadece 4 son geçiş kartı) */
    var canMisafirKart = ViewBag.CanMisafirKart as bool? ?? false;
    var showHareketListesi = ViewBag.ShowHareketListesi as bool? ?? false;
    var initialPasses = ViewBag.LastPasses as List<CeyPASS.Entities.Concrete.LastPassDTO> ?? new List<CeyPASS.Entities.Concrete.LastPassDTO>();
    var initialMoves = ViewBag.LastMoves as List<CeyPASS.Entities.Concrete.KisiHareketDTO> ?? new List<CeyPASS.Entities.Concrete.KisiHareketDTO>();
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h2 class="mb-0">
                    <i class="bi bi-camera-video-fill text-primary me-2"></i>Canlı İzleme
                </h2>
                <small class="text-muted">
                    <i class="bi bi-building me-1"></i>@(string.IsNullOrEmpty(user?.FirmaAdi) ? $"Firma #{user?.FirmaId}" : user.FirmaAdi) • 
                    <i class="bi bi-person me-1"></i>Kullanıcı: @user?.KullaniciAdi
                </small>
            </div>
            <div class="d-flex gap-2 flex-wrap justify-content-end">
                @if (canMisafirKart)
                {
                    <button class="btn btn-outline-dark" type="button" onclick="openKartDurumlari()" title="Serbest/kısıtlı kartları toplu yönet">
                        <i class="bi bi-sliders me-1"></i>Kart durumları
                    </button>
                }
                <form method="post" asp-controller="CanliIzleme" asp-action="Logout">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-danger" type="submit" title="Canlı İzleme modundan çık">
                        <i class="bi bi-box-arrow-right me-1"></i>Çıkış
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Son geçenler (4 kart) - WinForms tasarımına yakın -->
    <div class="row g-4 @(showHareketListesi ? "mb-4" : "mb-0 cards-only-layout")" id="lastPassesRow">
        @for (int i = 0; i < 4; i++)
        {
            var p = i < initialPasses.Count ? initialPasses[i] : null;
            var bgColor = p?.GirisMi == true ? "#2e7d32" : "#c62828"; // SeaGreen ve Firebrick'e yakın
            <div class="col-xl-3 col-lg-6">
                <div class="card shadow-lg h-100 last-pass-card border-0" data-index="@i" style="transition: transform 0.2s, box-shadow 0.2s;">
                    <div class="card-body text-center p-4">
                        <!-- Büyük fotoğraf (WinForms: 254x268) -->
                        <div class="mb-3 last-pass-photo-wrap">
                            <img class="rounded border border-2 last-pass-photo" width="200" height="240" alt="" 
                                 src="@GetImgSrc(p?.Foto)" 
                                 onerror="this.onerror=null; this.src=&quot;data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 240'%3E%3Crect width='200' height='240' fill='%23f1f5f9'/%3E%3Ccircle cx='100' cy='80' r='40' fill='%23cbd5e1'/%3E%3Cellipse cx='100' cy='195' rx='60' ry='45' fill='%23cbd5e1'/%3E%3C/svg%3E&quot;;"
                                 style="object-fit: cover; border-color: #dee2e6 !important;" />
                        </div>
                        
                        <!-- Ad Soyad (Bold, ortalanmış) -->
                        <div class="fw-bold fs-5 mb-3" style="color: #212529; min-height: 28px;">
                            @((p?.AdSoyad) ?? "-")
                        </div>
                    </div>
                    
                    <!-- Alt bilgi paneli (WinForms pnlAltBilgi) -->
                    <div class="text-white p-3" style="background-color: @bgColor;">
                        <div class="d-flex align-items-center justify-content-center mb-2">
                            <i class="bi bi-clock-history me-2"></i>
                            <span class="fw-semibold">@((p != null) ? p.Zaman.ToString("dd.MM.yyyy HH:mm:ss") : "-")</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-center">
                            <i class="bi bi-door-open me-2"></i>
                            <span class="fw-semibold">@((p?.TerminalAdi) ?? "-")</span>
                        </div>
                        <div class="text-center mt-2">
                            <span class="badge bg-light text-dark px-3 py-1">
                                @(p?.GirisMi == true ? "GİRİŞ" : "ÇIKIŞ")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (canMisafirKart)
    {
    <div class="row g-3 mb-3">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <h5 class="mb-0 d-flex align-items-center gap-2">
                        <span><i class="bi bi-credit-card me-2"></i>Kart Atamaları</span>
                        <button class="btn btn-sm btn-outline-secondary rounded-circle" type="button" data-bs-toggle="modal" data-bs-target="#atamaYardimModal" title="Durumlar" aria-label="Kart Atamaları yardımı" style="width:28px;height:28px;padding:0;line-height:1;">?</button>
                    </h5>
                    <div class="d-flex align-items-center gap-2">
                        <label class="mb-0 small text-muted" for="atamaTip">Kart tipi</label>
                        <select id="atamaTip" class="form-select form-select-sm" style="width: 180px;" onchange="refreshAtamaListe(true)">
                            <option value="misafir">Misafir / Ziyaretçi</option>
                            <option value="arac">Araç</option>
                        </select>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 360px; overflow-y: auto;">
                        <table class="table table-sm table-hover mb-0" id="atamaTable">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Kart</th>
                                    <th>Kişi / Plaka</th>
                                    <th>Durum</th>
                                    <th class="text-end">İşlem</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="atamaYardimModal" tabindex="-1" aria-labelledby="atamaYardimTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="atamaYardimTitle">Kart Atamaları — durumlar</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body small">
                    <p class="mb-1"><strong style="color:#E67E22">HAZIR</strong>: Kart boşta; kimseye verilmemiş. Çift tıklayınca yeni atama açılır.</p>
                    <p class="mb-1"><strong style="color:#47698A">ATANMIŞ</strong>: Kart birine verilmiş; henüz turnikede giriş/çıkış yok.</p>
                    <p class="mb-1"><strong style="color:#2E8B57">GİRİŞ</strong>: Atama sonrası son hareket giriş (içeride).</p>
                    <p class="mb-2"><strong style="color:#B22222">ÇIKIŞ</strong>: Atama sonrası son hareket çıkış.</p>
                    <p class="mb-1">ATANMIŞ / GİRİŞ / ÇIKIŞ satırına çift tık → atamayı güncelleyin (Kartı Kısıtla’dan bağımsızdır).</p>
                    <p class="mb-1">Satırın sağındaki Kartı Kısıtla / Kart Kısıtı Kaldır: cihaz kuyruğuna komut yazar; atamayı değiştirmez.</p>
                    <p class="mb-1">Kısıt kanıtı yoksa kart serbest sayılır. Atanmış+serbest → Kısıtla; kısıtlı → Kısıtı Kaldır; HAZIR+serbest → ikisi kapalı.</p>
                    <p class="mb-1">Kart durumları: misafir+araç anlık serbest/kısıtlı listesi (Tümü/Misafir/Araç); seçerek veya topluca yönetin.</p>
                    <p class="mb-0">Üstteki Misafir / Araç seçimi liste tipini değiştirir.</p>
                </div>
            </div>
        </div>
    </div>
    }

    @if (showHareketListesi)
    {
    <div class="row g-3">
        <!-- Son hareketler -->
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-list-ul me-2"></i>Son Hareketler
                    </h5>
                    <small class="text-muted">1 sn’de bir güncellenir</small>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 520px; overflow-y:auto;">
                        <table class="table table-hover table-striped mb-0" id="movesTable">
                            <thead class="table-dark sticky-top">
                                <tr>
                                    <th>Tarih</th>
                                    <th>Ad Soyad</th>
                                    <th>Turnike</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in initialMoves)
                                {
                                    <tr data-kisiid="@m.PersonelId">
                                        <td>@m.Tarih.ToString("dd.MM.yyyy HH:mm:ss")</td>
                                        <td>@m.AdSoyad</td>
                                        <td>@m.CihazAdi</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    }
</div>

@if (canMisafirKart)
{
<div class="modal fade" id="kartDurumModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Kart durumları</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <label class="mb-0 small text-muted">Kart tipi</label>
                    <select id="durumTip" class="form-select form-select-sm" style="width: 140px;" onchange="renderDurumRows()">
                        <option value="tumu">Tümü</option>
                        <option value="misafir">Misafir</option>
                        <option value="arac">Araç</option>
                    </select>
                    <button type="button" class="btn btn-sm text-white" style="background:#3b82f6" onclick="setDurumSelection(true)">Tümünü seç</button>
                    <button type="button" class="btn btn-sm text-white" style="background:#64748b" onclick="setDurumSelection(false)">Seçimi kaldır</button>
                    <button type="button" class="btn btn-sm text-white" style="background:#ea580c" onclick="enqueueDurum('selected', true)">Seçilenleri kısıtla</button>
                    <button type="button" class="btn btn-sm text-white" style="background:#0d9488" onclick="enqueueDurum('selected', false)">Seçilenleri serbest bırak</button>
                    <button type="button" class="btn btn-sm text-white" style="background:#dc2626" onclick="enqueueDurum('serbest', true)">Tüm serbestleri kısıtla</button>
                    <button type="button" class="btn btn-sm text-white" style="background:#16a34a" onclick="enqueueDurum('kisitli', false)">Tüm kısıtlıları serbest bırak</button>
                </div>
                <div class="table-responsive" style="max-height: 420px;">
                    <table class="table table-sm table-hover mb-0" id="durumTable">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th style="width:36px"></th>
                                <th>Tip</th>
                                <th>Kart</th>
                                <th>Kişi / Plaka</th>
                                <th>Atama</th>
                                <th>Cihaz</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<form id="kartAfForm" class="d-none">@Html.AntiForgeryToken()</form>
}

<!-- Misafir Kart Modal -->
<div class="modal fade" id="misafirModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="misafirModalTitle">Misafir Kart</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="misafirModalBody">
                <div class="text-muted">Yükleniyor...</div>
            </div>
        </div>
    </div>
</div>

@functions {
    private static readonly string DefaultAvatarSvg = CreateDefaultAvatar();
    
    private static string CreateDefaultAvatar()
    {
        // Profesyonel, minimalist avatar - gri tonlarda kişi silueti
        var svg = @"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 240'>
            <rect width='200' height='240' fill='#f1f5f9'/>
            <circle cx='100' cy='80' r='40' fill='#cbd5e1'/>
            <ellipse cx='100' cy='195' rx='60' ry='45' fill='#cbd5e1'/>
        </svg>";
        return "data:image/svg+xml;base64," + Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(svg));
    }
    
    private string GetImgSrc(byte[]? foto)
    {
        // Fotoğraf yoksa veya geçersizse default avatar döndür
        if (foto == null || foto.Length < 100)
        {
            return DefaultAvatarSvg;
        }
        
        // JPEG/PNG header kontrolü - bozuk veri kontrolü
        try
        {
            // JPEG: FF D8 FF ile başlar
            // PNG: 89 50 4E 47 ile başlar
            bool isValidJpeg = foto.Length > 3 && foto[0] == 0xFF && foto[1] == 0xD8 && foto[2] == 0xFF;
            bool isValidPng = foto.Length > 4 && foto[0] == 0x89 && foto[1] == 0x50 && foto[2] == 0x4E && foto[3] == 0x47;
            
            if (!isValidJpeg && !isValidPng)
            {
                return DefaultAvatarSvg;
            }
            
            string mimeType = isValidPng ? "image/png" : "image/jpeg";
            return $"data:{mimeType};base64," + Convert.ToBase64String(foto);
        }
        catch
        {
            return DefaultAvatarSvg;
        }
    }
}

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .last-pass-card {
            transition: all 0.3s ease;
        }
        .last-pass-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.3) !important;
        }
        .last-pass-card.updating {
            animation: cardPulse 0.5s ease-out;
        }
        @@keyframes cardPulse {
            0% { transform: scale(1); box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); }
            50% { transform: scale(1.02); box-shadow: 0 0 30px rgba(99, 102, 241, 0.5); }
            100% { transform: scale(1); box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); }
        }
        .new-entry-glow {
            animation: glowEffect 1s ease-out;
        }
        @@keyframes glowEffect {
            0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
            70% { box-shadow: 0 0 0 15px rgba(16, 185, 129, 0); }
            100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
        }
        #movesTable tbody tr {
            transition: background-color 0.2s ease;
        }
        #movesTable tbody tr:hover {
            background-color: #e0e7ff !important;
            cursor: pointer;
        }
        #movesTable tbody tr.table-primary {
            background-color: #c7d2fe !important;
        }
        #movesTable tbody tr.new-row {
            animation: highlightNew 2s ease-out;
        }
        @@keyframes highlightNew {
            0% { background-color: #bbf7d0; }
            100% { background-color: transparent; }
        }
        .selected-info-item {
            transition: all 0.2s ease;
        }
        .selected-info-item:hover {
            background: #e2e8f0 !important;
            transform: translateX(5px);
        }
        .status-indicator {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 8px;
            animation: blink 2s infinite;
        }
        .status-indicator.online {
            background: #10b981;
        }
        @@keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        .cards-only-layout {
            min-height: calc(100vh - 140px);
            align-content: stretch;
        }
        .cards-only-layout .last-pass-card {
            min-height: calc(100vh - 160px);
            display: flex;
            flex-direction: column;
        }
        .cards-only-layout .last-pass-card .card-body {
            flex: 1 1 auto;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .cards-only-layout .last-pass-photo-wrap {
            flex: 1 1 auto;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 280px;
        }
        .cards-only-layout .last-pass-photo {
            width: min(100%, 360px) !important;
            height: auto !important;
            max-height: 55vh;
            aspect-ratio: 5 / 6;
            object-fit: cover;
        }
    </style>
    <script>
        // Son geçiş kartları: 2 sn poll; gereksiz DOM güncellemesi cache ile engellenir
        const pollMs = 2000;
        const showHareketListesi = @(showHareketListesi ? "true" : "false");
        const canKartAtama = @(canMisafirKart ? "true" : "false");
        
        // Son veriyi cache'de tut - sadece değişiklik olduğunda güncelle
        let lastPassesCache = [];
        let lastMovesCache = [];
        let lastMoveTimestamp = null;

        // Default avatar - minimalist gri siluet (URL encoded SVG)
        const defaultAvatar = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 240'%3E%3Crect width='200' height='240' fill='%23f1f5f9'/%3E%3Ccircle cx='100' cy='80' r='40' fill='%23cbd5e1'/%3E%3Cellipse cx='100' cy='195' rx='60' ry='45' fill='%23cbd5e1'/%3E%3C/svg%3E";
        
        function setImg(imgEl, base64) {
            if (base64 && base64.length > 100) {
                imgEl.src = 'data:image/jpeg;base64,' + base64;
            } else {
                imgEl.src = defaultAvatar;
            }
        }
        
        // Bozuk resim yüklenirse default avatar göster
        function handleImageError(img) {
            img.onerror = null; // Sonsuz döngüyü önle
            img.src = defaultAvatar;
        }

        // Veri değişti mi kontrolü
        function hasDataChanged(oldData, newData) {
            if (!oldData || !newData) return true;
            if (oldData.length !== newData.length) return true;
            
            for (let i = 0; i < newData.length; i++) {
                const oldItem = oldData[i];
                const newItem = newData[i];
                if (!oldItem || !newItem) return true;
                
                // Zaman damgası değiştiyse yeni veri gelmiş demektir
                if (oldItem.zaman !== newItem.zaman) return true;
                if (oldItem.personelId !== newItem.personelId) return true;
            }
            return false;
        }

        // Belirli bir kartı güncelle (sadece o kart için animasyon)
        function updateCard(cardIndex, p, animate = false) {
            const card = document.querySelectorAll('.last-pass-card')[cardIndex];
            if (!card) return;

            const img = card.querySelector('img');
            const nameEl = card.querySelector('.fw-bold.fs-5');
            const timeEl = card.querySelectorAll('.fw-semibold')[0];
            const terminalEl = card.querySelectorAll('.fw-semibold')[1];
            const badgeEl = card.querySelector('.badge');
            const footer = card.querySelector('.text-white.p-3');

            if (!p) {
                img.src = '@GetImgSrc(null)';
                if (nameEl) nameEl.textContent = '-';
                if (timeEl) timeEl.textContent = '-';
                if (terminalEl) terminalEl.textContent = '-';
                if (badgeEl) badgeEl.textContent = '-';
                return;
            }

            // Fotoğraf kontrolü - minimum 100 karakter base64 verisi olmalı
            if (p.fotoBase64 && p.fotoBase64.length > 100) {
                img.src = 'data:image/jpeg;base64,' + p.fotoBase64;
                img.onerror = function() { this.onerror=null; this.src=defaultAvatar; };
            } else {
                img.src = defaultAvatar;
            }
            if (nameEl) nameEl.textContent = p.adSoyad || '-';
            if (timeEl) timeEl.textContent = new Date(p.zaman).toLocaleString('tr-TR', { 
                day: '2-digit', month: '2-digit', year: 'numeric', 
                hour: '2-digit', minute: '2-digit', second: '2-digit' 
            });
            if (terminalEl) terminalEl.textContent = p.terminalAdi || '-';
            if (badgeEl) badgeEl.textContent = p.girisMi ? 'GİRİŞ' : 'ÇIKIŞ';
            
            // Giriş/çıkış alt paneli: WinForms SeaGreen / Firebrick tonları
            const bgColor = p.girisMi ? '#2e7d32' : '#c62828';
            if (footer) footer.style.backgroundColor = bgColor;

            // Sadece yeni veri geldiğinde animasyon
            if (animate) {
                card.classList.remove('updating', 'new-entry-glow');
                void card.offsetWidth; // Force reflow
                card.classList.add('updating', 'new-entry-glow');
                setTimeout(() => {
                    card.classList.remove('updating', 'new-entry-glow');
                }, 1000);
            }
        }

        async function refreshLastPasses() {
            const res = await fetch('@Url.Action("LastPasses")');
            if (!res.ok) return;
            const data = await res.json();

            // Veri değişmemişse güncelleme yapma
            if (!hasDataChanged(lastPassesCache, data)) {
                return; // Değişiklik yok, hiçbir şey yapma
            }

            // Hangi kartlar değişti kontrol et
            for (let i = 0; i < 4; i++) {
                const oldItem = lastPassesCache[i];
                const newItem = data[i];
                
                // Bu kart değişti mi?
                const cardChanged = !oldItem || !newItem || 
                    oldItem.zaman !== newItem?.zaman || 
                    oldItem.personelId !== newItem?.personelId;
                
                if (cardChanged) {
                    updateCard(i, newItem, true); // Animasyonlu güncelle
                }
            }

            // Cache'i güncelle
            lastPassesCache = data;
        }

        async function refreshMoves() {
            if (!showHareketListesi) return;
            const res = await fetch('@Url.Action("LastMoves")');
            if (!res.ok) return;
            const data = await res.json();

            // İlk kayıtın zamanını kontrol et - değişmediyse güncelleme
            const newFirstTimestamp = data[0]?.tarih;
            if (newFirstTimestamp && newFirstTimestamp === lastMoveTimestamp) {
                return; // Yeni hareket yok
            }
            lastMoveTimestamp = newFirstTimestamp;

            const tbody = document.querySelector('#movesTable tbody');
            if (!tbody) return;
            const existingIds = Array.from(tbody.querySelectorAll('tr')).map(tr => tr.dataset.kisiid + '_' + tr.querySelector('td')?.textContent);
            
            tbody.innerHTML = '';

            for (let idx = 0; idx < data.length; idx++) {
                const m = data[idx];
                const tr = document.createElement('tr');
                tr.dataset.kisiid = m.kisiId;
                tr.style.cursor = 'pointer';
                
                const timeStr = new Date(m.tarih).toLocaleString('tr-TR');
                tr.innerHTML = `
                    <td>${timeStr}</td>
                    <td>${m.adSoyad ?? ''}</td>
                    <td>${m.cihazAdi ?? ''}</td>
                `;
                
                // Yeni satır mı kontrolü (ilk birkaç satır için)
                const rowKey = m.kisiId + '_' + timeStr;
                if (idx < 3 && !existingIds.includes(rowKey)) {
                    tr.classList.add('new-row');
                }
                
                tbody.appendChild(tr);
            }
        }

        async function tick() {
            try { await refreshLastPasses(); } catch (e) { console.warn('LastPasses error:', e); }
            if (showHareketListesi) {
                try { await refreshMoves(); } catch (e) { console.warn('Moves error:', e); }
            }
        }

        // Atama durum renkleri (yardım modalı ile aynı): boşta / atanmış / son hareket giriş-çıkış
        function durumBadge(text) {
            const map = { 'HAZIR': '#E67E22', 'ATANMIŞ': '#47698A', 'GİRİŞ': '#2E8B57', 'ÇIKIŞ': '#B22222' };
            const bg = map[text] || '#64748b';
            return `<span class="badge" style="background:${bg}">${text || ''}</span>`;
        }

        function afToken() {
            return document.querySelector('#kartAfForm input[name="__RequestVerificationToken"]')?.value || '';
        }

        let atamaRows = [];
        async function refreshAtamaListe(force) {
            if (!canKartAtama) return;
            const tip = document.getElementById('atamaTip')?.value || 'misafir';
            const res = await fetch('@Url.Action("AtamaListe")?tip=' + encodeURIComponent(tip));
            if (!res.ok) return;
            const data = await res.json();
            const key = JSON.stringify(data);
            if (!force && key === window._atamaKey) return;
            window._atamaKey = key;
            atamaRows = data || [];
            const tbody = document.querySelector('#atamaTable tbody');
            if (!tbody) return;
            tbody.innerHTML = atamaRows.map(r => `
                <tr data-pid="${r.personelId}" data-tip="${r.tip}" data-durum="${r.durum}" data-atama="${r.atamaId ?? ''}" style="cursor:pointer">
                    <td>${r.kartAdi ?? ''}</td>
                    <td>${r.kisiPlaka ?? ''}</td>
                    <td>${durumBadge(r.durumText)}</td>
                    <td class="text-end text-nowrap">
                        <button type="button" class="btn btn-sm btn-danger me-1" ${r.canKisitla ? '' : 'disabled'} onclick="event.stopPropagation(); enqueueOne('${r.personelId}', true)">Kartı Kısıtla</button>
                        <button type="button" class="btn btn-sm btn-success" ${r.canSerbestBirak ? '' : 'disabled'} onclick="event.stopPropagation(); enqueueOne('${r.personelId}', false)">Kart Kısıtı Kaldır</button>
                    </td>
                </tr>`).join('');
            // Çift tık: satır atama modalını açar (tek tık komut butonları için ayrılmış)
            tbody.querySelectorAll('tr').forEach(tr => {
                tr.addEventListener('dblclick', () => openAtamaFromRow(tr.dataset));
            });
        }

        // HAZIR → yeni atama partial; ATANMIŞ/GİRİŞ/ÇIKIŞ → güncelleme partial (misafir/araç ayrımı)
        function openAtamaFromRow(ds) {
            const q = ds.durum === 'Hazir'
                ? (ds.tip === 'arac'
                    ? '@Url.Action("AracKartiYeni")?personelId=' + encodeURIComponent(ds.pid)
                    : '@Url.Action("MisafirKartYeni")?personelId=' + encodeURIComponent(ds.pid))
                : (ds.tip === 'arac'
                    ? '@Url.Action("AracKartiGuncelle")?atamaId=' + encodeURIComponent(ds.atama || '')
                    : '@Url.Action("MisafirKartGuncelle")?atamaId=' + encodeURIComponent(ds.atama || ''));
            const title = ds.durum === 'Hazir'
                ? (ds.tip === 'arac' ? 'Araç Kartı Ver' : 'Misafir Kart Atama - Yeni')
                : (ds.tip === 'arac' ? 'Verilen Araç Kartını Güncelle' : 'Misafir Kart Atama - Güncelleme');
            document.getElementById('misafirModalTitle').textContent = title;
            loadModal(q);
        }

        // KartKomut: cihaz komut kuyruğu (pasif=kısıt); veritabanı atamasını değiştirmez
        async function enqueueOne(personelId, pasif) {
            const n = pasif ? 'kısıtlansın' : 'kısıtı kaldırılsın';
            if (!confirm('Kart ' + n + ' mı?')) return;
            const body = new URLSearchParams();
            body.set('personelId', personelId);
            body.set('pasif', pasif ? 'true' : 'false');
            body.set('__RequestVerificationToken', afToken());
            const res = await fetch('@Url.Action("KartKomut")', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
            const data = await res.json();
            if (!data.ok) { alert(data.message || 'İşlem başarısız'); return; }
            window._atamaKey = '';
            await refreshAtamaListe(true);
            if (window._durumSnapshot) await loadDurumSnapshot();
        }

        let _durumSnapshot = null;
        async function openKartDurumlari() {
            await loadDurumSnapshot();
            bootstrap.Modal.getOrCreateInstance(document.getElementById('kartDurumModal')).show();
        }
        async function loadDurumSnapshot() {
            const res = await fetch('@Url.Action("AtamaListe")?tip=tumu');
            if (!res.ok) return;
            _durumSnapshot = (await res.json() || []).map(r => ({ ...r, selected: false }));
            renderDurumRows();
        }
        function filteredDurum() {
            const tip = document.getElementById('durumTip')?.value || 'tumu';
            return (_durumSnapshot || []).filter(r => tip === 'tumu' || r.tip === tip);
        }
        function renderDurumRows() {
            const tbody = document.querySelector('#durumTable tbody');
            if (!tbody) return;
            tbody.innerHTML = filteredDurum().map(r => `
                <tr>
                    <td><input type="checkbox" ${r.selected ? 'checked' : ''} onchange="toggleDurum('${r.personelId}', this.checked)" /></td>
                    <td>${r.tipLabel ?? ''}</td>
                    <td>${r.kartAdi ?? ''}</td>
                    <td>${r.kisiPlaka ?? ''}</td>
                    <td>${r.durumText ?? ''}</td>
                    <td>${r.cihazdaAktif ? 'Serbest' : 'Kısıtlı'}</td>
                </tr>`).join('');
        }
        function toggleDurum(pid, on) {
            const r = (_durumSnapshot || []).find(x => x.personelId === pid);
            if (r) r.selected = on;
        }
        function setDurumSelection(on) {
            filteredDurum().forEach(r => r.selected = on);
            renderDurumRows();
        }
        async function enqueueDurum(mode, pasif) {
            const pool = filteredDurum();
            const targets = mode === 'selected'
                ? pool.filter(r => r.selected)
                : mode === 'serbest'
                    ? pool.filter(r => r.cihazdaAktif)
                    : pool.filter(r => !r.cihazdaAktif);
            if (targets.length === 0) {
                alert(mode === 'selected' ? 'Önce kart seçin.' : (pasif ? 'Serbest kart yok.' : 'Kısıtlı kart yok.'));
                return;
            }
            if (!confirm(targets.length + ' kart için komut yazılsın mı?')) return;
            let ok = 0;
            try {
                for (const r of targets) {
                    const body = new URLSearchParams();
                    body.set('personelId', r.personelId);
                    body.set('pasif', pasif ? 'true' : 'false');
                    body.set('__RequestVerificationToken', afToken());
                    const res = await fetch('@Url.Action("KartKomut")', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
                    const data = await res.json();
                    if (!data.ok) throw new Error(data.message || 'Hata');
                    r.cihazdaAktif = !pasif;
                    ok++;
                }
                alert((pasif ? 'Kısıtlama' : 'Kısıt kaldırma') + ' komutu kuyruğa alındı: ' + ok);
            } catch (e) {
                alert(ok > 0 ? (ok + ' kart yazıldı, sonra hata:\n' + e.message) : e.message);
            }
            renderDurumRows();
            window._atamaKey = '';
            await refreshAtamaListe(true);
        }

        if (canKartAtama) {
            refreshAtamaListe(true);
            // Atama listesi turnike hareketine daha duyarlı: 1 sn poll (JSON aynıysa DOM dokunulmaz)
            setInterval(() => refreshAtamaListe(false), 1000);
        }

        async function loadModal(url) {
            const modalBody = document.getElementById('misafirModalBody');
            modalBody.innerHTML = '<div class="text-muted">Yükleniyor...</div>';
            const res = await fetch(url);
            modalBody.innerHTML = await res.text();
            const modal = new bootstrap.Modal(document.getElementById('misafirModal'));
            modal.show();
        }

        // initial wiring
        document.addEventListener('DOMContentLoaded', () => {
            // İlk veriyi cache'e al
            @if (initialPasses.Any())
            {
                <text>
                lastPassesCache = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(initialPasses.Select(p => new { 
                    zaman = p.Zaman, 
                    personelId = p.PersonelId,
                    adSoyad = p.AdSoyad,
                    terminalAdi = p.TerminalAdi,
                    girisMi = p.GirisMi
                })));
                </text>
            }
            
            @if (initialMoves.Any())
            {
                <text>
                lastMoveTimestamp = '@initialMoves.First().Tarih.ToString("o")';
                </text>
            }

            // Polling başlat
            setInterval(tick, pollMs);
        });
    </script>
}

