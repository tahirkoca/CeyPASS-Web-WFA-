@model CeyPASS.Web.Models.CanliIzleme.AracKartiYeniModel
@{
    var cards = ViewBag.Cards as List<CeyPASS.Entities.Concrete.KisiListItem> ?? new List<CeyPASS.Entities.Concrete.KisiListItem>();
}

<form id="aracYeniForm" method="post" asp-controller="CanliIzleme" asp-action="AracKartiYeni">
    @Html.AntiForgeryToken()

    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label fw-semibold">Geçmiş Ziyaretçiler</label>
            <input type="text" class="form-control mb-2" id="gecmisAraArac" placeholder="İsim veya plaka ara..." autocomplete="off" />
            <select id="gecmisListeArac" class="form-select" size="12" style="min-height: 280px;">
            </select>
            <div class="form-text">Listeden seçince Ad Soyad, T.C., Plaka ve Kime Geldiği dolar.</div>
        </div>
        <div class="col-md-8">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Kart</label>
                    <select name="KartId" class="form-select" required>
                        <option value="">-- Seçiniz --</option>
                        @foreach (var c in cards)
                        {
                            <option value="@c.PersonelId">@c.AdSoyad</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Giriş Saati</label>
                    <input type="datetime-local" class="form-control" name="GirisSaati" id="GirisSaatiArac"
                           value="@Model.GirisSaati.ToString("yyyy-MM-ddTHH:mm")" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">T.C. Kimlik No</label>
                    <input class="form-control" name="TCKimlikNo" id="TCKimlikNoArac" maxlength="11" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Araç Plakası</label>
                    <input class="form-control" name="Plaka" id="PlakaArac" maxlength="20" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Kime Geldiği</label>
                    <input class="form-control" name="ZiyaretEdilenKisi" id="ZiyaretEdilenKisiArac" />
                </div>
                <div class="col-12">
                    <p class="form-text text-muted small mb-0">
                        T.C. zorunlu değildir. T.C. girip alandan çıkınca veya Enter'a basınca boş alanlar otomatik doldurulur.
                        Geçmiş listeden seçim alanları doğrudan yazar.
                    </p>
                </div>
                <div class="col-md-12">
                    <label class="form-label">Ad Soyad</label>
                    <input class="form-control" name="AdSoyad" id="AdSoyadArac" required />
                </div>
                <div class="col-md-12">
                    <label class="form-label">Açıklama</label>
                    <textarea class="form-control" name="Aciklama" rows="3"></textarea>
                </div>
                <div class="col-12 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-warning text-white">Kaydet</button>
                </div>
            </div>
        </div>
    </div>
</form>

<script>
    (function () {
        const form = document.getElementById('aracYeniForm');
        const tcInput = document.getElementById('TCKimlikNoArac');
        const adInput = document.getElementById('AdSoyadArac');
        const kimeGeldigiInput = document.getElementById('ZiyaretEdilenKisiArac');
        const plakaInput = document.getElementById('PlakaArac');
        const girisInput = document.getElementById('GirisSaatiArac');
        const gecmisAra = document.getElementById('gecmisAraArac');
        const gecmisListe = document.getElementById('gecmisListeArac');
        const gecmisUrl = '@Url.Action("SearchGecmisZiyaretciler", "CanliIzleme")';
        let gecmisItems = [];

        function toLocalInputValue(d) {
            const pad = n => String(n).padStart(2, '0');
            return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate())
                + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
        }

        async function loadGecmis() {
            const ad = (gecmisAra?.value || '').trim();
            try {
                const res = await fetch(gecmisUrl + '?tip=arac&ad=' + encodeURIComponent(ad));
                if (!res.ok) return;
                const data = await res.json();
                if (!data.ok) return;
                gecmisItems = data.items || [];
                gecmisListe.innerHTML = '';
                gecmisItems.forEach((it, idx) => {
                    const opt = document.createElement('option');
                    opt.value = String(idx);
                    opt.textContent = it.plaka ? ((it.adSoyad || '') + ' (' + it.plaka + ')') : (it.adSoyad || '—');
                    gecmisListe.appendChild(opt);
                });
            } catch (e) { }
        }

        if (gecmisAra) gecmisAra.addEventListener('input', loadGecmis);
        if (gecmisListe) {
            gecmisListe.addEventListener('change', function () {
                const it = gecmisItems[parseInt(gecmisListe.value, 10)];
                if (!it) return;
                adInput.value = it.adSoyad || '';
                tcInput.value = it.tcKimlikNo || '';
                if (plakaInput) plakaInput.value = it.plaka || '';
                kimeGeldigiInput.value = it.ziyaretEdilenKisi || '';
                if (girisInput) girisInput.value = toLocalInputValue(new Date());
            });
        }
        loadGecmis();

        async function tryFillByTc() {
            const tc = tcInput.value.trim();
            if (!tc) return;
            try {
                const url = '@Url.Action("GetAracByTc", "CanliIzleme")' + '?tc=' + encodeURIComponent(tc);
                const res = await fetch(url, { method: 'GET' });
                if (!res.ok) return;
                const data = await res.json();
                if (!data.ok) return;
                if (data.adSoyad && !adInput.value.trim()) adInput.value = data.adSoyad;
                if (data.ziyaretEdilenKisi && !kimeGeldigiInput.value.trim()) kimeGeldigiInput.value = data.ziyaretEdilenKisi;
                if (data.plaka && plakaInput && !plakaInput.value.trim()) plakaInput.value = data.plaka;
            } catch (e) { }
        }

        if (tcInput) {
            tcInput.addEventListener('blur', tryFillByTc);
            tcInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    tryFillByTc();
                }
            });
        }

        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            const fd = new FormData(form);
            const res = await fetch(form.action, { method: 'POST', body: fd });
            const data = await res.json();
            if (!data.ok) {
                toastr.error(data.message || 'İşlem başarısız.');
                return;
            }
            toastr.success(data.message || 'Tamamlandı.');
            bootstrap.Modal.getInstance(document.getElementById('misafirModal'))?.hide();
        });
    })();
</script>
