@model CeyPASS.Web.Models.CanliIzleme.MisafirKartYeniModel
@{
    var cards = ViewBag.Cards as List<CeyPASS.Entities.Concrete.KisiListItem> ?? new List<CeyPASS.Entities.Concrete.KisiListItem>();
}

<form id="misafirYeniForm" method="post" asp-controller="CanliIzleme" asp-action="MisafirKartYeni">
    @Html.AntiForgeryToken()

    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label fw-semibold">Geçmiş Ziyaretçiler</label>
            <input type="text" class="form-control mb-2" id="gecmisAraMisafir" placeholder="İsim ara..." autocomplete="off" />
            <select id="gecmisListeMisafir" class="form-select" size="12" style="min-height: 280px;">
            </select>
            <div class="form-text">Listeden seçince Ad Soyad, T.C. ve Kime Geldiği dolar.</div>
        </div>
        <div class="col-md-8">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Kart</label>
                    <select name="KartId" class="form-select" required>
                        <option value="">-- Seçiniz --</option>
                        @foreach (var c in cards)
                        {
                            <option value="@c.PersonelId">@c.AdSoyad</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Giriş Saati</label>
                    <input type="datetime-local" class="form-control" name="GirisSaati" id="GirisSaati"
                           value="@Model.GirisSaati.ToString("yyyy-MM-ddTHH:mm")" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">T.C. Kimlik No *</label>
                    <input class="form-control" name="TCKimlikNo" id="TCKimlikNo" maxlength="11" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Kime Geldiği</label>
                    <input class="form-control" name="ZiyaretEdilenKisi" id="ZiyaretEdilenKisi" />
                </div>
                <div class="col-12">
                    <p class="form-text text-muted small mb-0">
                        T.C. Kimlik No zorunludur (11 hane). T.C. girip alandan çıkınca veya Enter'a basınca boş alanlar otomatik doldurulur.
                        Geçmiş listeden seçim alanları doğrudan yazar.
                    </p>
                </div>
                <div class="col-md-12">
                    <label class="form-label">Misafir Ad Soyad</label>
                    <input class="form-control" name="MisafirAdSoyad" id="MisafirAdSoyad" required />
                </div>
                <div class="col-md-12">
                    <label class="form-label">Açıklama</label>
                    <textarea class="form-control" name="Aciklama" rows="3"></textarea>
                </div>
                <div class="col-12 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </div>
        </div>
    </div>
</form>

<script>
    (function () {
        const form = document.getElementById('misafirYeniForm');
        const tcInput = document.getElementById('TCKimlikNo');
        const misafirInput = document.getElementById('MisafirAdSoyad');
        const kimeGeldigiInput = document.getElementById('ZiyaretEdilenKisi');
        const girisInput = document.getElementById('GirisSaati');
        const gecmisAra = document.getElementById('gecmisAraMisafir');
        const gecmisListe = document.getElementById('gecmisListeMisafir');
        const gecmisUrl = '@Url.Action("SearchGecmisZiyaretciler", "CanliIzleme")';
        let gecmisItems = [];
        let tamTc = null;
        let suppressTcChange = false;
        const Tc = window.TcKimlik;

        function showMaskedTc(fullTc) {
            tamTc = (fullTc || '').trim() || null;
            suppressTcChange = true;
            tcInput.value = tamTc ? Tc.mask(tamTc) : '';
            suppressTcChange = false;
        }

        function toLocalInputValue(d) {
            const pad = n => String(n).padStart(2, '0');
            return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate())
                + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
        }

        async function loadGecmis() {
            const ad = (gecmisAra?.value || '').trim();
            try {
                const res = await fetch(gecmisUrl + '?tip=misafir&ad=' + encodeURIComponent(ad));
                if (!res.ok) return;
                const data = await res.json();
                if (!data.ok) return;
                gecmisItems = data.items || [];
                gecmisListe.innerHTML = '';
                gecmisItems.forEach((it, idx) => {
                    const opt = document.createElement('option');
                    opt.value = String(idx);
                    opt.textContent = it.gosterim || it.adSoyad || '—';
                    gecmisListe.appendChild(opt);
                });
            } catch (e) { }
        }

        if (gecmisAra) gecmisAra.addEventListener('input', loadGecmis);
        if (gecmisListe) {
            gecmisListe.addEventListener('change', function () {
                const it = gecmisItems[parseInt(gecmisListe.value, 10)];
                if (!it) return;
                misafirInput.value = it.adSoyad || '';
                showMaskedTc(it.tcKimlikNo);
                kimeGeldigiInput.value = it.ziyaretEdilenKisi || '';
                if (girisInput) girisInput.value = toLocalInputValue(new Date());
            });
        }
        loadGecmis();

        async function tryFillByTc() {
            const tc = tcInput.value.trim();
            if (!tc || (Tc && Tc.looksMasked(tc))) return;

            try {
                const url = '@Url.Action("GetMisafirByTc", "CanliIzleme")' + '?tc=' + encodeURIComponent(tc);
                const res = await fetch(url, { method: 'GET' });
                if (!res.ok) return;
                const data = await res.json();
                if (!data.ok) return;

                if (data.misafirAdSoyad && !misafirInput.value.trim()) misafirInput.value = data.misafirAdSoyad;
                if (data.ziyaretEdilenKisi && !kimeGeldigiInput.value.trim()) kimeGeldigiInput.value = data.ziyaretEdilenKisi;
            } catch (e) { }
        }

        if (tcInput) {
            tcInput.addEventListener('input', function () {
                if (suppressTcChange) return;
                var shown = (tcInput.value || '').trim();
                if (tamTc && Tc && shown === Tc.mask(tamTc)) return;
                tamTc = null;
            });
            tcInput.addEventListener('blur', tryFillByTc);
            tcInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    tryFillByTc();
                }
            });
        }

        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            try {
                tcInput.value = Tc.resolveForSave(tcInput.value, tamTc);
            } catch (err) {
                toastr.error(err.message || 'T.C. Kimlik No geçersiz.');
                return;
            }
            const fd = new FormData(form);
            const res = await fetch(form.action, { method: 'POST', body: fd });
            const data = await res.json();
            if (!data.ok) {
                toastr.error(data.message || 'İşlem başarısız.');
                return;
            }
            toastr.success(data.message || 'Tamamlandı.');
            const modalEl = document.getElementById('misafirModal');
            bootstrap.Modal.getInstance(modalEl)?.hide();
        });
    })();
</script>
