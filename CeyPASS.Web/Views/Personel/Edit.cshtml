@model CeyPASS.Entities.Concrete.KisiDetay
@{
    ViewData["Title"] = "Personel Düzenle";
    var originalPersonelId = ViewBag.OriginalPersonelId as string ?? Model?.PersonelId;
    var pozisyonlar = ViewBag.Pozisyonlar as List<CeyPASS.Entities.Concrete.LookupItem> ?? new List<CeyPASS.Entities.Concrete.LookupItem>();
    var isyerleri = ViewBag.Isyerleri as List<CeyPASS.Entities.Concrete.LookupItem> ?? new List<CeyPASS.Entities.Concrete.LookupItem>();
    var bolumler = ViewBag.Bolumler as List<CeyPASS.Entities.Concrete.LookupItem> ?? new List<CeyPASS.Entities.Concrete.LookupItem>();
    var calismaSekilleri = ViewBag.CalismaSekilleri as List<CeyPASS.Entities.Concrete.CalismaSekli> ?? new List<CeyPASS.Entities.Concrete.CalismaSekli>();
    var calismaStatuleri = ViewBag.CalismaStatuleri as List<CeyPASS.Entities.Concrete.LookupItem> ?? new List<CeyPASS.Entities.Concrete.LookupItem>();
    var firmalar = ViewBag.Firmalar as List<CeyPASS.Entities.Concrete.Firma> ?? new List<CeyPASS.Entities.Concrete.Firma>();
    var isDeparted = Model?.IstenCikisTarihi.HasValue == true;
    var calismaDurumu = ViewBag.CalismaDurumu as string ?? (isDeparted ? "cikan" : "aktif");
    int cokluPidJs = 0;
    if (Model?.PersonelId != null) int.TryParse(Model.PersonelId, out cokluPidJs);
    
    // Seçili vardiyaları parse et
    var seciliVardiyaIds = new HashSet<int>();
    if (!string.IsNullOrWhiteSpace(Model?.CalismaSekliCsv))
    {
        seciliVardiyaIds = new HashSet<int>(
            Model.CalismaSekliCsv.Split(',')
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Select(int.Parse)
        );
    }
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <h2>Personel Düzenle</h2>
            <a href="@Url.Action("Index", new { kartTipi = ViewBag.KartTipi, firmaId = ViewBag.SelectedFirmaId, page = ViewBag.Page, pageSize = ViewBag.PageSize, search = ViewBag.Search, isyeriId = ViewBag.SelectedIsyeriId, calismaDurumu })" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Geri Dön
            </a>
        </div>
    </div>

    @if (!isDeparted)
    {
        <div class="alert alert-info small mb-3">
            <strong>Zorunlu alanlar (*):</strong> Sicil No, Ad, Soyad, İşe Giriş, İşyeri (ve Firma) her zaman zorunludur.
            Firma Personeli veya Taşeron → TC Kimlik No; Ziyaretçi veya Araç Kartı → Kart No; Yemek Hakkı → Yemek Adedi.
            İlgili işaret kalkınca koşullu <code>*</code> de kalkar.
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" name="originalPersonelId" value="@originalPersonelId" />
        <input type="hidden" name="kartTipi" value="@(ViewBag.KartTipi)" />
        <input type="hidden" name="firmaId" value="@(ViewBag.SelectedFirmaId)" />
        <input type="hidden" name="page" value="@(ViewBag.Page ?? 1)" />
        <input type="hidden" name="pageSize" value="@(ViewBag.PageSize ?? 20)" />
        <input type="hidden" name="search" value="@(ViewBag.Search ?? "")" />
        <input type="hidden" name="isyeriId" value="@(ViewBag.SelectedIsyeriId ?? "")" />
        
        <fieldset @(isDeparted ? "disabled" : null)>
        <div class="row">
            <!-- Sol Kolon -->
            <div class="col-md-6">
                <div class="card mb-3">
                    <div class="card-header">
                        <h5 class="mb-0">Temel Bilgiler</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="PersonelId" class="form-label">Sicil No <span class="text-danger">*</span></label>
                            <input asp-for="PersonelId" class="form-control" required />
                            <span asp-validation-for="PersonelId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Ad" class="form-label">Ad <span class="text-danger">*</span></label>
                            <input asp-for="Ad" class="form-control" required />
                            <span asp-validation-for="Ad" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Soyad" class="form-label">Soyad <span class="text-danger">*</span></label>
                            <input asp-for="Soyad" class="form-control" required />
                            <span asp-validation-for="Soyad" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TcKimlikNo" class="form-label">TC Kimlik No <span id="req-tc" class="text-danger d-none">*</span></label>
                            <input asp-for="TcKimlikNo" class="form-control" maxlength="11" />
                            <span asp-validation-for="TcKimlikNo" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="KartNo" class="form-label">Kart No <span id="req-kart" class="text-danger d-none">*</span></label>
                            <input asp-for="KartNo" class="form-control" />
                            <span asp-validation-for="KartNo" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DogumTarihi" class="form-label">Doğum Tarihi</label>
                            <input asp-for="DogumTarihi" type="date" class="form-control" />
                            <span asp-validation-for="DogumTarihi" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IseGirisTarihi" class="form-label">İşe Giriş Tarihi <span class="text-danger">*</span></label>
                            <input asp-for="IseGirisTarihi" type="date" class="form-control" required />
                            <span asp-validation-for="IseGirisTarihi" class="text-danger"></span>
                        </div>

                        @if (Model?.IstenCikisTarihi.HasValue == true)
                        {
                            <div class="mb-3">
                                <label class="form-label">İşten Çıkış Tarihi</label>
                                <input type="date" value="@Model.IstenCikisTarihi.Value.ToString("yyyy-MM-dd")" class="form-control" disabled />
                                <small class="form-text text-muted">Bu personel işten çıkarılmış.</small>
                            </div>
                        }
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header">
                        <h5 class="mb-0">İletişim Bilgileri</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="CepTel" class="form-label">Cep Telefonu</label>
                            <input asp-for="CepTel" class="form-control" />
                            <span asp-validation-for="CepTel" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">E-posta</label>
                            <input asp-for="Email" type="email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sağ Kolon -->
            <div class="col-md-6">
                <div class="card mb-3">
                    <div class="card-header">
                        <h5 class="mb-0">Organizasyon Bilgileri</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="FirmaId" class="form-label">Firma <span class="text-danger">*</span></label>
                            <select asp-for="FirmaId" class="form-select" required>
                                <option value="">-- Seçiniz --</option>
                                @foreach (var firma in firmalar)
                                {
                                    if (firma.FirmaId == Model?.FirmaId)
                                    {
                                        <option value="@firma.FirmaId" selected="selected">@firma.FirmaAdi</option>
                                    }
                                    else
                                    {
                                        <option value="@firma.FirmaId">@firma.FirmaAdi</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="FirmaId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IsyeriId" class="form-label">İşyeri <span class="text-danger">*</span></label>
                            <select asp-for="IsyeriId" class="form-select">
                                <option value="">-- Seçiniz --</option>
                                @foreach (var isyeri in isyerleri)
                                {
                                    if (isyeri.Id == Model?.IsyeriId)
                                    {
                                        <option value="@isyeri.Id" selected="selected">@isyeri.Ad</option>
                                    }
                                    else
                                    {
                                        <option value="@isyeri.Id">@isyeri.Ad</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="IsyeriId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PozisyonId" class="form-label">Pozisyon</label>
                            <select asp-for="PozisyonId" class="form-select">
                                <option value="">-- Seçiniz --</option>
                                @foreach (var pozisyon in pozisyonlar)
                                {
                                    if (pozisyon.Id == Model?.PozisyonId)
                                    {
                                        <option value="@pozisyon.Id" selected="selected">@pozisyon.Ad</option>
                                    }
                                    else
                                    {
                                        <option value="@pozisyon.Id">@pozisyon.Ad</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="PozisyonId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="BolumId" class="form-label">Bölüm</label>
                            <select asp-for="BolumId" class="form-select">
                                <option value="">-- Seçiniz --</option>
                                @foreach (var bolum in bolumler)
                                {
                                    if (bolum.Id == Model?.BolumId)
                                    {
                                        <option value="@bolum.Id" selected="selected">@bolum.Ad</option>
                                    }
                                    else
                                    {
                                        <option value="@bolum.Id">@bolum.Ad</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="BolumId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Çalışma Statüsü</label>
                            <select name="CalismaStatusu" class="form-select">
                                <option value="">-- Seçiniz --</option>
                                @foreach (var statu in calismaStatuleri)
                                {
                                    if (statu.Ad == Model?.CalismaStatusuText)
                                    {
                                        <option value="@statu.Ad" selected="selected">@statu.Ad</option>
                                    }
                                    else
                                    {
                                        <option value="@statu.Ad">@statu.Ad</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header">
                        <h5 class="mb-0">Çalışma Şekilleri (Vardiyalar)</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @foreach (var vardiya in calismaSekilleri)
                            {
                                <div class="col-md-6 mb-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="VardiyaIds" value="@vardiya.Id" id="vardiya_@vardiya.Id" 
                                               @(seciliVardiyaIds.Contains(vardiya.Id) ? "checked" : "") />
                                        <label class="form-check-label" for="vardiya_@vardiya.Id">
                                            @vardiya.Ad
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header">
                        <h5 class="mb-0">Özel Ayarlar</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" name="firmaPersoneli" id="firmaPersoneli" value="true" 
                                   @(Model?.FirmaPersoneli == true ? "checked" : "") />
                            <label class="form-check-label" for="firmaPersoneli">
                                Firma Personeli
                            </label>
                        </div>

                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" name="puantajYapilabilir" id="puantajYapilabilir" value="true"
                                   @(Model?.PuantajYapilabilir == true ? "checked" : "") />
                            <label class="form-check-label" for="puantajYapilabilir">
                                Puantaj Yapılır
                            </label>
                        </div>

                        <hr class="my-2" />

                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" name="yemekHakkiVar" id="yemekHakkiVar" value="true" 
                                   @(Model?.YemekHakkiVar == true ? "checked" : "") />
                            <label class="form-check-label" for="yemekHakkiVar">
                                Yemek Hakkı Var
                            </label>
                        </div>

                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" name="ziyaretciMi" id="ziyaretciMi" value="true" 
                                   @(Model?.ZiyaretciMi == true ? "checked" : "") />
                            <label class="form-check-label" for="ziyaretciMi">
                                Ziyaretçi Kartı
                            </label>
                        </div>

                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" name="aracKartiMi" id="aracKartiMi" value="true" 
                                   @(Model?.AracKartiMi == true ? "checked" : "") />
                            <label class="form-check-label" for="aracKartiMi">
                                Araç Kartı
                            </label>
                        </div>

                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" name="taseronCalisanMi" id="taseronCalisanMi" value="true" 
                                   @(Model?.TaseronCalisanMi == true ? "checked" : "") />
                            <label class="form-check-label" for="taseronCalisanMi">
                                Taşeron Çalışan
                            </label>
                        </div>

                        <div class="mb-3">
                            <label for="gunlukYemekAdedi" class="form-label">Günlük Yemek Adedi <span id="req-yemek" class="text-danger d-none">*</span></label>
                            <input type="number" name="gunlukYemekAdedi" id="gunlukYemekAdedi" class="form-control" min="0" 
                                   value="@(Model?.GunlukYemekAdedi.HasValue == true ? Model.GunlukYemekAdedi.Value.ToString() : "")" />
                        </div>

                        <div class="mb-3">
                            <label for="firmaDisiKartNo" class="form-label">Firma Dışı Kart No (Taseron)</label>
                            <input type="text" name="firmaDisiKartNo" id="firmaDisiKartNo" class="form-control" 
                                   value="@Model?.TaseronKartNo" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card mb-3">
                    <div class="card-header">
                        <h5 class="mb-0">Fotoğraf</h5>
                    </div>
                    <div class="card-body">
                        @if (Model?.Fotograf != null && Model.Fotograf.Length > 0)
                        {
                            <div class="mb-3">
                                <label class="form-label">Mevcut Fotoğraf</label>
                                <div>
                                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Fotograf)" 
                                         class="img-thumbnail" style="max-width: 200px; max-height: 200px;" />
                                </div>
                            </div>
                        }
                        
                        <div class="mb-3">
                            <label for="fotograf" class="form-label">Yeni Fotoğraf Yükle</label>
                            <input type="file" name="fotograf" id="fotograf" class="form-control" accept="image/*" />
                            <small class="form-text text-muted">Yeni fotoğraf yüklerseniz mevcut fotoğraf değiştirilir.</small>
                        </div>
                        <div id="fotoPreview" class="mt-2"></div>
                        <input type="hidden" name="fotoDegisti" id="fotoDegisti" value="false" />
                    </div>
                </div>
            </div>
        </div>
        </fieldset>

        @if (!isDeparted)
        {
            <div class="row">
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Güncelle
                    </button>
                    <a href="@Url.Action("Index", new { kartTipi = ViewBag.KartTipi, firmaId = ViewBag.SelectedFirmaId, page = ViewBag.Page, pageSize = ViewBag.PageSize, search = ViewBag.Search, isyeriId = ViewBag.SelectedIsyeriId, calismaDurumu })" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> İptal
                    </a>
                    <button type="button" class="btn btn-outline-primary" id="btnCokluSicil" title="Hedef sicil eşleştirmeleri">
                        <i class="bi bi-diagram-3"></i> Çoklu Sicil
                    </button>
                </div>
            </div>
        }
    </form>

    @if (isDeparted)
    {
        <div class="row mt-3">
            <div class="col-12">
                <div class="alert alert-warning">
                    Bu personel işten çıkarılmış. Bilgiler salt okunurdur; tekrar aktif etmek için aşağıdaki işlemi kullanın.
                </div>
                <form asp-action="TekrarAktifEt" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.PersonelId" />
                    <input type="hidden" name="kartTipi" value="@(ViewBag.KartTipi)" />
                    <input type="hidden" name="firmaId" value="@(ViewBag.SelectedFirmaId)" />
                    <input type="hidden" name="page" value="@(ViewBag.Page ?? 1)" />
                    <input type="hidden" name="pageSize" value="@(ViewBag.PageSize ?? 20)" />
                    <input type="hidden" name="search" value="@(ViewBag.Search ?? "")" />
                    <input type="hidden" name="isyeriId" value="@(ViewBag.SelectedIsyeriId ?? "")" />
                    <input type="hidden" name="calismaDurumu" value="cikan" />
                    <div class="mb-3">
                        <label class="form-label">Puantaj yapılan bir kart mı?</label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="puantajYapilirMi" id="puantajEvet" value="true" checked="checked" />
                            <label class="form-check-label" for="puantajEvet">Evet</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="puantajYapilirMi" id="puantajHayir" value="false" />
                            <label class="form-check-label" for="puantajHayir">Hayır</label>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-person-check"></i> Aktif Et
                    </button>
                    <a href="@Url.Action("Index", new { kartTipi = ViewBag.KartTipi, firmaId = ViewBag.SelectedFirmaId, page = ViewBag.Page, pageSize = ViewBag.PageSize, search = ViewBag.Search, isyeriId = ViewBag.SelectedIsyeriId, calismaDurumu })" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> İptal
                    </a>
                </form>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="cokluSicilModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Çoklu Sicil Eşleştirmeleri</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive mb-3">
                    <table class="table table-sm table-striped" id="cokluSicilGrid">
                        <thead><tr><th>Hedef</th><th>Ad Soyad</th><th>Firma/İşyeri</th><th>Aktarım Gün</th><th>Aktif</th><th></th></tr></thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Hedef Sicil</label>
                        <select class="form-select" id="cokluSicilHedef"></select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Aktarım Gün</label>
                        <input type="number" class="form-control" id="cokluSicilAktarimGun" min="1" value="1" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Açıklama</label>
                        <input type="text" class="form-control" id="cokluSicilAciklama" />
                    </div>
                    <div class="col-md-2">
                        <div class="form-check"><input class="form-check-input" type="checkbox" id="cokluSicilAktif" checked /><label class="form-check-label" for="cokluSicilAktif">Aktif</label></div>
                    </div>
                </div>
                <div class="text-danger small mt-2" id="cokluSicilError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger" id="cokluSicilPasifTumunu">Tümünü pasifleştir</button>
                <button type="button" class="btn btn-primary" id="cokluSicilKaydet">Kaydet</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
    
    <script src="~/js/personel-required.js" asp-append-version="true"></script>
    <script>
        var cokluPersonelId = @cokluPidJs;
        var cokluTcKimlik = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.TcKimlikNo ?? ""));
        // Firma değiştiğinde İşyeri, Bölüm listelerini güncelle
        $('#FirmaId').change(function() {
            var firmaId = $(this).val();
            if (firmaId) {
                $.get('@Url.Action("GetIsyerleri")', { firmaId: firmaId }, function(data) {
                    $('#IsyeriId').empty().append('<option value="">-- Seçiniz --</option>');
                    $.each(data, function(i, item) {
                        var selected = item.id == @(Model?.IsyeriId ?? 0) ? 'selected' : '';
                        $('#IsyeriId').append($('<option>', { value: item.id, text: item.ad }).attr('selected', selected));
                    });
                });

                $.get('@Url.Action("GetBolumler")', { firmaId: firmaId }, function(data) {
                    $('#BolumId').empty().append('<option value="">-- Seçiniz --</option>');
                    $.each(data, function(i, item) {
                        var selected = item.id == @(Model?.BolumId ?? 0) ? 'selected' : '';
                        $('#BolumId').append($('<option>', { value: item.id, text: item.ad }).attr('selected', selected));
                    });
                });
            }
        });

        // Fotoğraf değiştiğinde
        $('#fotograf').change(function(e) {
            $('#fotoDegisti').val('true');
            var file = e.target.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    $('#fotoPreview').html('<img src="' + e.target.result + '" class="img-thumbnail" style="max-width: 200px; max-height: 200px;" />');
                };
                reader.readAsDataURL(file);
            }
        });

        var cokluEditingHedefId = null;
        var cokluToken = $('input[name="__RequestVerificationToken"]').val();

        function refreshCokluSicilUi() {
            if (cokluPersonelId <= 0) return;
            $.get('@Url.Action("CokluSicilListe")', { personelId: cokluPersonelId }, function(data) {
                var ozet = data.ozet || {};
                var isAna = !!(ozet.isAnaSicil || ozet.IsAnaSicil);
                var isHedefOnly = !!(ozet.isHedefSicil || ozet.IsHedefSicil) && !isAna;
                var puantaj = $('#puantajYapilabilir').is(':checked');
                var hasTc = (cokluTcKimlik || '').trim().length > 0;
                var canOpen = puantaj && hasTc && !isHedefOnly && !@(isDeparted ? "true" : "false");
                $('#btnCokluSicil').prop('disabled', !canOpen);
                var tip = canOpen ? 'Hedef sicil eşleştirmeleri'
                    : @(isDeparted ? "true" : "false") ? 'İşten çıkan personelde kullanılamaz.'
                    : isHedefOnly ? 'Bu sicil yalnızca hedef sicildir.'
                    : !puantaj ? 'Puantaj Yapılır işaretlenmelidir.'
                    : !hasTc ? 'TC kimlik numarası girilmelidir.'
                    : 'Hedef sicil eşleştirmeleri';
                $('#btnCokluSicil').attr('title', tip);
            });
        }

        function loadCokluSicilModal() {
            $.get('@Url.Action("CokluSicilListe")', { personelId: cokluPersonelId }, function(data) {
                var tbody = $('#cokluSicilGrid tbody').empty();
                (data.baglantilar || []).forEach(function(b) {
                    var hedefId = b.hedefPersonelId || b.HedefPersonelId;
                    tbody.append('<tr><td>' + hedefId + '</td><td>' + (b.hedefAdSoyad || b.HedefAdSoyad || '') + '</td><td>' +
                        (b.firmaAdi || b.FirmaAdi || '-') + ' / ' + (b.isyeriAdi || b.IsyeriAdi || '-') + '</td><td>' +
                        (b.aktarimGunSayisi || b.AktarimGunSayisi) + '</td><td>' + ((b.aktifMi || b.AktifMi) ? 'Evet' : 'Hayır') +
                        '</td><td><button type="button" class="btn btn-sm btn-outline-primary coklu-edit" data-id="' + hedefId + '">Düzenle</button></td></tr>');
                });
            });
            $.get('@Url.Action("CokluSicilHedefAdaylari")', { personelId: cokluPersonelId }, function(list) {
                var sel = $('#cokluSicilHedef').empty().append('<option value="">-- Seçiniz --</option>');
                (list || []).forEach(function(a) {
                    var id = a.personelId || a.PersonelId;
                    var engel = (a.engelMesaji || a.EngelMesaji || '');
                    var label = id + ' — ' + (a.adSoyad || a.AdSoyad);
                    if (engel) label += ' [' + engel + ']';
                    sel.append('<option value="' + id + '">' + label + '</option>');
                });
            });
        }

        var yemekHakkiBaslangic = $('#yemekHakkiVar').is(':checked');
        $('#yemekHakkiVar').closest('form').on('submit', function(e) {
            if (yemekHakkiBaslangic && !$('#yemekHakkiVar').is(':checked')
                && !confirm(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(CeyPASS.Business.Services.YemekhaneEtkiMesaji.KaldirmaOnayi)))) {
                e.preventDefault();
                e.stopImmediatePropagation();
            }
        });

        refreshCokluSicilUi();
        $('#puantajYapilabilir').change(refreshCokluSicilUi);
        $('#btnCokluSicil').click(function() {
            if (!cokluPersonelId) return;
            loadCokluSicilModal();
            new bootstrap.Modal(document.getElementById('cokluSicilModal')).show();
        });
        $('#cokluSicilGrid').on('click', '.coklu-edit', function() {
            cokluEditingHedefId = $(this).data('id');
            $('#cokluSicilHedef').val(String(cokluEditingHedefId));
        });
        $('#cokluSicilPasifTumunu').click(function() {
            var aktifSayisi = 0;
            $('#cokluSicilGrid tbody tr').each(function() {
                var cells = $(this).find('td');
                if (cells.length >= 5 && $(cells[4]).text().trim() === 'Evet') aktifSayisi++;
            });
            if (aktifSayisi <= 0) return;
            if (!confirm(aktifSayisi + ' aktif hedef bağlantı pasifleştirilecek. Devam edilsin mi?')) return;
            $.ajax({
                url: '@Url.Action("CokluSicilPasiflestirTumunu")',
                type: 'POST',
                headers: { 'RequestVerificationToken': cokluToken },
                data: { personelId: cokluPersonelId },
                success: function() { loadCokluSicilModal(); refreshCokluSicilUi(); },
                error: function(xhr) { $('#cokluSicilError').text((xhr.responseJSON && xhr.responseJSON.message) || 'Pasifleştirme hatası'); }
            });
        });
        $('#cokluSicilKaydet').click(function() {
            var hedefId = parseInt($('#cokluSicilHedef').val(), 10);
            if (!hedefId) { $('#cokluSicilError').text('Hedef sicil seçiniz.'); return; }
            $('#cokluSicilError').text('');
            $.ajax({
                url: '@Url.Action("CokluSicilUpsert")?personelId=' + cokluPersonelId,
                type: 'POST',
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': cokluToken },
                data: JSON.stringify({
                    hedefPersonelId: hedefId,
                    aktarimGunSayisi: parseInt($('#cokluSicilAktarimGun').val(), 10) || 1,
                    aciklama: $('#cokluSicilAciklama').val(),
                    aktifMi: $('#cokluSicilAktif').is(':checked')
                }),
                success: function() { loadCokluSicilModal(); refreshCokluSicilUi(); },
                error: function(xhr) { $('#cokluSicilError').text((xhr.responseJSON && xhr.responseJSON.message) || 'Kayıt hatası'); }
            });
        });
    </script>
}
